<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Proxy.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <!-- Serve the reference CSS out of wwwroot so the sample page (and any client
       bundle mounted into it) picks up the canonical stylesheet. -->
  <ItemGroup>
    <Content Include="..\..\..\src\Fuaran.UI.Renderer\content\fuaran-reference.css"
             Link="wwwroot\fuaran-reference.css"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fuaran.UI.Client is the SERVER-side tier: plain .NET (System.Net.Http),
         deliberately not Fable-portable. The browser half of this sample speaks
         the wire contract directly — see ../client/. -->
    <ProjectReference Include="..\..\..\src\Fuaran.UI.Client\Fuaran.UI.Client.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
