<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App.fs" />
    <Compile Include="Form.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <!-- Serve the two static assets out of wwwroot: the generic shim (from the
       ServerDriven package's content/) and the reference CSS (from the Renderer
       package's content/). Linked + copied so the sample needs no manual copy. -->
  <ItemGroup>
    <Content Include="..\..\src\Fuaran.UI.ServerDriven\content\fuaran-live-patch.js"
             Link="wwwroot\fuaran-live-patch.js"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\Fuaran.UI.Renderer\content\fuaran-reference.css"
             Link="wwwroot\fuaran-reference.css"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.UI.Renderer.Core\Fuaran.UI.Renderer.Core.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.UI.Renderer.Server\Fuaran.UI.Renderer.Server.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.UI.ServerDriven\Fuaran.UI.ServerDriven.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.UI.ServerDriven.AspNetCore\Fuaran.UI.ServerDriven.AspNetCore.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
