<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Fable client convention: gate every Fable-only path via FABLE_COMPILER
         + DEBUG so Fable transpiles them but `dotnet build` doesn't try to
         compile Browser.Types-flavoured code on the .NET side.
         FUARAN_DEBUG_GLOBAL is a SEPARATE, explicit opt-in (Phase 1532) — it is
         what makes this host pass `debug:true` at `register`. The renderer
         needs the same symbol in ITS OWN compilation, which for a Fable build
         means passing that symbol on the fable command line on the command line: symbols do
         not cross project boundaries. A Release build defines neither, so
         nothing is registered and no relay listener is installed. -->
    <DefineConstants Condition="'$(Configuration)' != 'Release'">FABLE_COMPILER;DEBUG;FUARAN_DEBUG_GLOBAL</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Release'">FABLE_COMPILER</DefineConstants>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="index.html" />
    <None Include="index.css" />
    <None Include="vite.config.mts" />
    <None Include="package.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ApplyParity.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.UI.Renderer\Fuaran.UI.Renderer.fsproj" />
    <!-- The whole point of Phase 191: a Fable host can now reference the
         decode + apply engine. This is the first such consumer. -->
    <ProjectReference Include="..\..\src\Fuaran.UI.Ops\Fuaran.UI.Ops.fsproj" />
    <!-- Phase 192: the canonical encoder (CanonicalJson.encodeNode), now
         Fable-portable, is the apply-parity oracle's post-apply projection. -->
    <ProjectReference Include="..\..\src\Fuaran.UI.OpStream.Abstractions\Fuaran.UI.OpStream.Abstractions.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Elmish" />
    <PackageReference Include="Fable.Elmish.React" />
    <PackageReference Include="Feliz" />
  </ItemGroup>
</Project>
