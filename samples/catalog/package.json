{
  "name": "fuaran-catalog",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fable": "dotnet fable -o output --noCache",
    "build": "npm run fable && vite build",
    "preview": "vite preview",
    "snapshot": "playwright test --config snapshot/playwright.config.mts",
    "snapshot:update": "playwright test --config snapshot/playwright.config.mts --update-snapshots"
  },
  "dependencies": {
    "react": "~19.2.6",
    "react-dom": "~19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.13"
  }
}
