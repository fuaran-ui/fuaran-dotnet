<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ========================================================================
       Phase 577 — the VB leg of the embedded-renderer sample pair.

       A minimal ASP.NET app that authors a tree with VB XML LITERALS, serves
       its canonical wire JSON, and hydrates it in the browser through the
       embedded browser renderer. Same claim as the C# leg: there is no Node
       toolchain here.

       No fixed port. The sample binds whatever ASPNETCORE_URLS (or the urls
       switch) names, so it needs no allocation from the workspace port band and
       two copies can run side by side.

       Under samples/, excluded from the packable set and the Validate glob,
       and deletable without touching any shipped suite.
       ======================================================================== -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fuaran.UI.Samples.EmbeddedRenderer.Vb</RootNamespace>
    <AssemblyName>Fuaran.UI.Samples.EmbeddedRenderer.Vb</AssemblyName>
    <IsPackable>false</IsPackable>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.UI.VisualBasic\Fuaran.UI.VisualBasic.vbproj" />
    <ProjectReference Include="..\..\src\Fuaran.UI.Renderer.Web\Fuaran.UI.Renderer.Web.fsproj" />
    <!-- Only for Theme.vocabularyFingerprint, the authoring half of the drift
         comparison the snippet reports at development time. -->
    <ProjectReference Include="..\..\src\Fuaran.UI.Renderer.Core\Fuaran.UI.Renderer.Core.fsproj" />
  </ItemGroup>

</Project>
