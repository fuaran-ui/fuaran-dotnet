<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Andrew J. Willshire</Authors>
    <Company>Diametrical Ltd</Company>
    <Copyright>Copyright 2026 Diametrical Ltd</Copyright>
    <!-- 0.5.0 (Phase 330 — the interaction-correlation spine): BREAKING on two
         public surfaces, pre-1.0 so it rides a minor bump.
         `IFuaranTelemetrySink` gains a sixth abstract member
         (`RecordValidateOutcome`), per the pre-1.0-minor-add precedent this
         interface documents for itself — every direct implementer adds
         `member _.RecordValidateOutcome _ = ()`. And
         `Render.RenderContext` gains a required `SessionContext` field, so a
         host constructing the record literally stops compiling until it adds
         `SessionContext = Map.empty`. Consumers repin. -->
    <!-- 0.6.0 (Phase 330, second slice): additive —
         `Render.renderWithSourcesSinkAndContext`, the correlation-aware render
         entry a host calls to thread its opaque SessionContext. Additive, but a
         public-contract addition never rides a same-version repack (the
         workspace producer-side pinning rule), and 0.5.0 was already published.
         -->
    <!-- 0.7.0 (Phase 725): `FormFieldKind` gains a `DateRange` case — the
         single-control date range. Additive on the wire (no existing emission
         changes meaning), but a new DU case breaks every consumer's exhaustive
         `match` over `FormFieldKind`, which is a source break under F#'s
         `TreatWarningsAsErrors` even though STABILITY.md classifies DU
         exhaustiveness as non-breaking. Either way it is a public-contract
         addition, so it takes its own version rather than repacking 0.6.0. -->
    <!-- 0.8.0 (Phases 692-694 — the swap onto the IDL-generated types): BREAKING
         across the whole `Fuaran.UI` type surface, pre-1.0 so it rides a minor
         bump. `Types.fs` no longer DEFINES the wire vocabulary; it ABBREVIATES
         `Fuaran.UI.Generated` (the IDL emission). One version covers the whole
         swap, per the staged plan — not one per stage. See STABILITY.md
         "Recorded change - 0.8.0". Consumers repin and expect source edits at
         record literals; the smart-ctor authoring surface is unchanged (the
         `samples/demo` application has ZERO source changes across the swap). -->
    <!-- 0.9.0 — ADDITIVE renderer surface (no consumer edits): the scope-aware
         render entry that also carries a telemetry sink
         (`renderWithSourcesInScopeAndSink`), and the host-pluggable `GuestSeam`
         that puts a rendered `Mount` guest behind the host's capability policy.
         See STABILITY.md "Recorded change - 0.9.0". -->
    <!-- 0.10.0 — the op-stream slice: DAG checkpoint verification + the
         `OpStream.Abstractions` decode leg. MINOR, and the axis is worth
         stating because two of the four changes look major at a glance.
         (1) `DagReplayError` gains `SnapshotHashMismatch` — a new DU case, so a
         source break under `TreatWarningsAsErrors`, which STABILITY.md's Semver
         section classifies as NON-breaking and 0.7.0 already settled on exactly
         this shape. (2) `GuestExport.FormatVersion` 1 -> 2 refuses v1 documents
         by name, but `Fuaran.UI.OpStream.Replay` is an explicitly UNSTABLE
         surface, so it carries no semver promise and cannot drive the axis up.
         (3) `replayFromCheckpoint` now VERIFIES `SnapshotHash` where it
         previously never read it — a behavioural tightening of the 0.3.3 class.
         (4) Additive `OpStream.Abstractions` surface (`StreamEntry.decode`,
         `coreWitnessWith`) — the feature addition that makes this a minor rather
         than the patch a tightening alone would take. The canonical wire did NOT
         move: `chainFormatVersion` stays 2, the `DagOpRecord` pre-image is
         untouched, no fixture changed. See STABILITY.md "Recorded change -
         0.10.0". -->
    <Version>0.10.0</Version>
  </PropertyGroup>

  <!-- Package metadata for the published Fuaran.UI.* packages (nuget.org
       + the fuaran-ui GitHub Packages feed). The repo is Apache-2.0;
       PackageLicenseExpression is the single licence channel — do not set
       PackageLicenseFile anywhere (the two are mutually exclusive:
       NU5033). -->
  <PropertyGroup>
    <RepositoryUrl>https://github.com/fuaran-ui/fuaran-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/fuaran-ui/fuaran-dotnet</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>
</Project>
