<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restore from nuget.org only: <clear /> drops any machine- or user-level
       feeds, so the starter builds the same way on every machine. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
