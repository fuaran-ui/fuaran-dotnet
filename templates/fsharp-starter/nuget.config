<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Workspace-local feed: the Fuaran.UI.* packs land here via pack-all.ps1,
         so the starter builds against your local checkout. OUTSIDE the Fuaran
         workspace this relative path won't exist — replace this line with the
         published feed:
           <add key="github-fuaran" value="https://nuget.pkg.github.com/fuaran-ui/index.json" />
         (a PAT with read:packages is required; see the workspace docs). -->
    <add key="local" value="../../../local-nuget-feed" />
  </packageSources>
</configuration>
