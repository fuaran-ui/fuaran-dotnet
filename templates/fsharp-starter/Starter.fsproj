<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Gate Fable-only code (Browser APIs, DOM) so it compiles under Fable but
         `dotnet build` on .NET doesn't try to. -->
    <DefineConstants Condition="'$(Configuration)' != 'Release'">FABLE_COMPILER;DEBUG</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Release'">FABLE_COMPILER</DefineConstants>
    <!-- Feliz (which the renderer draws with, and Fable compiles from source
         with this project's settings) pre-dates F# 10 nullness; disable the
         checker here (the Fuaran.UI typed-tree library keeps nullness on
         separately). -->
    <Nullable>disable</Nullable>
    <!-- One property pins every Fuaran.UI.* package; raise it to move the
         starter onto a newer nuget.org release. -->
    <FuaranUIVersion>0.106.0</FuaranUIVersion>
    <!-- One property pins every Fuaran.MVU.* package: the runtime the starter
         runs on (Fuaran.MVU), its React mount (Fuaran.MVU.React) and the
         browser host (Fuaran.MVU.Browser). -->
    <FuaranMVUVersion>0.1.0</FuaranMVUVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="index.html" />
    <None Include="index.css" />
    <None Include="vite.config.mts" />
    <None Include="package.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fuaran.UI" Version="$(FuaranUIVersion)" />
    <PackageReference Include="Fuaran.UI.Renderer" Version="$(FuaranUIVersion)" />
    <PackageReference Include="Fuaran.MVU" Version="$(FuaranMVUVersion)" />
    <PackageReference Include="Fuaran.MVU.React" Version="$(FuaranMVUVersion)" />
    <PackageReference Include="Fuaran.MVU.Browser" Version="$(FuaranMVUVersion)" />
    <PackageReference Include="Fable.Core" Version="5.0" />
  </ItemGroup>
</Project>
