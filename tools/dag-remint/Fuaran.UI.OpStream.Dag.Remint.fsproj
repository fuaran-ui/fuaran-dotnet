<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The one-release re-mint tool (Phase 2648): re-addresses a DAG store written
         before Phase 2645 (the cut) to Core's `Dag.nodeId`. A tool, never a package:
         it is deleted in the release after the cut's, with the pre-cut reader it holds. -->
    <IsPackable>false</IsPackable>
    <AssemblyName>dag-remint</AssemblyName>
    <RootNamespace>Fuaran.UI.OpStream.Dag.Remint</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Legacy.fs" />
    <Compile Include="Remint.fs" />
    <Compile Include="Stores.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.UI.Ops\Fuaran.UI.Ops.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.UI.OpStream.Abstractions\Fuaran.UI.OpStream.Abstractions.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.UI.OpStream.Dag.Abstractions\Fuaran.UI.OpStream.Dag.Abstractions.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.UI.OpStream.Dag.Sqlite\Fuaran.UI.OpStream.Dag.Sqlite.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.UI.OpStream.Dag.Merge\Fuaran.UI.OpStream.Dag.Merge.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
</Project>
