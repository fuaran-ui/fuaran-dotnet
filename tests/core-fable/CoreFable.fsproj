<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Fuaran.Core Fable gate's project (Phase 217). Compiled by `dotnet fable` in `core-fable.ps1`
    beside it, which is run by the Fable stage (`tests/fable-laws/fable-check.ps1`). It references
    every public Fuaran.Core package — membership is CHECKED by the script against this
    repository's `Fuaran.Core.*` pins, or against the candidate's packages in a cut-time run, with
    `exclusions.json` holding the deliberate exceptions — and `Program.fs` touches each one's public
    encode/decode surface. With `CoreParity=true` (set by the script only when the restored
    Fuaran.Core.Conformance ships `ParityVectors`) the same program is also the cross-pipeline VALUE
    leg.
    Not in the solution and not packed: the script restores, compiles and runs it on its own.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!--
      NULLNESS OFF, for the reason `tests/fable-laws/FableLaws.fsproj` states: under Fable the ENTRY
      project's properties govern the whole transpiled graph, and with nullness ON the canonical wire
      encoder emits a `StringBuilder__ToString` that the bundled fable-library-js does not export, so
      the transpiled program dies at import. This project is RUN under node, so it compiles the way
      a running consumer must. The nullness-ON compile of the packages this repository ships is the
      portability stage's job.
    -->
    <Nullable>disable</Nullable>
    <!-- Read by `src/Fuaran.UI.Tests/CoreConformanceCensus.fs`, which scans tests/* for law-family
         calls as evidence of this tier ADOPTING a family. The touches in Program.fs call Core's
         families only to compile them under Fable, so they are not adoption. -->
    <CoreConformanceCensusExemption>The Fuaran.Core Fable gate, run on Core's behalf (Phase 217): it compiles Core's law families under Fable, it does not adopt them for this tier.</CoreConformanceCensusExemption>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CoreParity)' == 'true'">
    <DefineConstants>$(DefineConstants);CORE_PARITY</DefineConstants>
  </PropertyGroup>
  <!--
    Version constants. `CoreFableEffectiveCore` is set by the script to the Fuaran.Core version this run
    compiles against (the candidate in a cut-time run, otherwise the pin). A candidate that breaks a
    spelling the smoke touches gets a constant here, defined at or past that version
    (`$([MSBuild]::VersionGreaterThanOrEquals('$(CoreFableEffectiveCore)', '<version>'))`), and
    Program.fs writes the new spelling under it. When the pin reaches that version, the constant and
    the old-pin arm it guards are deleted together. CORE_0_36 (Core Phases 398 and 390) was retired when
    the pin was raised to 0.36.0, and CORE_0_37 (a schema entry a `Field`, fuaran-core#423; a column a
    typed vector, fuaran-core#444) when it was raised to 0.38.1 (Phase 2226). None is defined today: the
    0.40.0 spellings (the `IdlField` canonical-form slots, Core Phase 539; the Text and Relation packages)
    were written unconditionally when the pin was raised to 0.40.2 (Phase 2286).
  -->
  <!--
    `CoreFableSkipCompute=true` is set by the script for a Core-only cut, and only then: the compute
    packages ship from their own producer from 0.33.0 and pin an older Core until this Core release is
    published, so they are gated by their own producer's cut, not compiled against this candidate. The
    references below stay in the file either way (the script's membership check reads them); the
    condition decides whether they are restored, and `CORE_FABLE_COMPUTE` whether Program.fs touches them.
  -->
  <PropertyGroup Condition="'$(CoreFableSkipCompute)' != 'true'">
    <DefineConstants>$(DefineConstants);CORE_FABLE_COMPUTE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <!-- The compute packages ($ComputeOwned in the script), under their own ids from 0.36.0. -->
  <ItemGroup Condition="'$(CoreFableSkipCompute)' != 'true'">
    <PackageReference Include="Fuaran.Compute.DataFrame" />
    <!-- First shipped at 0.32.0 (fuaran-core Phase 257); unconditional since Phase 1874 raised this repository's pin to carry it. -->
    <PackageReference Include="Fuaran.Compute.Conformance" />
    <PackageReference Include="Fuaran.Compute.ColumnOps" />
    <!-- Reached transitively through Fuaran.Compute.Conformance; referenced so the gate names every
         package the producer ships. -->
    <PackageReference Include="Fuaran.Compute.PipelineQuery" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fuaran.Core.Tree" />
    <PackageReference Include="Fuaran.Core.Ops" />
    <PackageReference Include="Fuaran.Core.OpStream" />
    <PackageReference Include="Fuaran.Core.OpStream.Dag" />
    <PackageReference Include="Fuaran.Core.Wire" />
    <PackageReference Include="Fuaran.Core.Validator" />
    <PackageReference Include="Fuaran.Core.Function" />
    <PackageReference Include="Fuaran.Core.Column" />
    <PackageReference Include="Fuaran.Core.Query" />
    <PackageReference Include="Fuaran.Core.Conformance" />
    <PackageReference Include="Fuaran.Core.Projection" />
    <PackageReference Include="Fuaran.Core.AiSurface" />
    <PackageReference Include="Fuaran.Core.Propagation" />
    <PackageReference Include="Fuaran.Core.Idl" />
    <PackageReference Include="Fuaran.Core.Observer" />
    <!-- From Core 0.35.2 (Phase 382); unconditional since Phase 2039 raised this repository's pin to carry it. -->
    <PackageReference Include="Fuaran.Core.ContentAddress" />
    <!-- From Core 0.37.0 (Phase 426); unconditional since Phase 2226 raised this repository's pin to carry it. -->
    <PackageReference Include="Fuaran.Core.Unit" />
    <!-- From Core 0.40.0 (fuaran-core Phase 552, Core D205): pinned alone in this directory by Phase 2382,
         ahead of the spine; unconditional and pinned in the root file since Phase 2286 raised it to 0.40.2. -->
    <PackageReference Include="Fuaran.Core.Relation" />
    <!-- From Core 0.40.0 (fuaran-core Phase 531, the kernel below Tree, Wire and OpStream); unconditional
         since Phase 2286 raised this repository's pin to carry it. -->
    <PackageReference Include="Fuaran.Core.Text" />
  </ItemGroup>
</Project>
