<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The packed-consumer leg's project (Phase 2128). Compiled by `dotnet fable` in
    `fable-pack-consumer.ps1` beside it, which the Fable stage (`tests/fable-laws/fable-check.ps1`)
    runs. It is a Fable consumer that reaches `Fuaran.UI.Telemetry.Default` the way a downstream
    client does: by PackageReference to the PACKED packages, never by ProjectReference. That is the
    whole point. Under Fable a ProjectReference is always compiled from source, so an in-repo
    consumer referencing the project would compile whether or not the package ships its sources;
    only a package reference sees what a consumer of the published package sees.
    Not in the solution and not packed: the script packs the producers, restores and compiles it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fuaran.UI.Telemetry.Abstractions" />
    <PackageReference Include="Fuaran.UI.Telemetry.Default" />
  </ItemGroup>
</Project>
