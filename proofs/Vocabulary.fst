  | [] -> []
  | y :: t -> JInt y :: enc_items_l_int t

and enc_items_l_node (#num #flt: eqtype) (xs: list (node num flt)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> enc_node y :: enc_items_l_node t

and enc_items_l_e_embed_permission (#num #flt: eqtype) (xs: list (e_embed_permission)) : Tot (list (jval num flt)) (decreases xs) =
