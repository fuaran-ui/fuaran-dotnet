and dec_items_l_int (#num #flt: eqtype) (acc: list (num)) (ys: list (jval num flt)) : Tot (outcome (list (num))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match as_int y with
     | Ok w -> dec_items_l_int (w :: acc) rest
     | Error e -> Error e)

and dec_items_l_node (#num #flt: eqtype) (acc: list (node num flt)) (ys: list (jval num flt)) : Tot (outcome (list (node num flt))) (decreases %[(jsizes ys <: nat); 1]) =
  match ys with
  | [] -> Ok (rev acc)
  | y :: rest ->
    (match dec_node y with
     | Ok w -> dec_items_l_node (w :: acc) rest
     | Error e -> Error e)

