(* ======================================================================================
   2. The vocabulary's types — one mutual group, because a record may hold a union, a
      union a node, and a node a list of nodes. Records are single-constructor types
      rather than F* records so that two objects declaring a `label` cannot collide.
   ====================================================================================== *)

type node (num flt: eqtype) =
  | C__node__Node : id:string -> k:(vkind num flt) -> accessibility:(option (r_accessibility num flt)) -> state:(option (r_state_behaviour num flt)) -> style:(option (r_semantic_style num flt)) -> tooltip:(option (u_text_source num flt)) -> visible:(option (u_binding__bool num flt)) -> node num flt

and vkind (num flt: eqtype) =
  | C__vkind__Badge : label:(u_text_source num flt) -> variant:(e_badge_variant) -> vkind num flt
  | C__vkind__Callout : body:(u_text_source num flt) -> dismissable:(bool) -> heading:(option (u_text_source num flt)) -> icon:(option (string)) -> tone:(e_tone_variant) -> vkind num flt
  | C__vkind__CodeBlock : code:(string) -> copyable:(bool) -> highlight_lines:(list (num)) -> language:(string) -> line_numbers:(bool) -> vkind num flt
  | C__vkind__Disclosure : children:(list (node num flt)) -> default_open:(bool) -> heading:(u_text_source num flt) -> on_toggle:(option (unit)) -> open_:(u_binding__bool num flt) -> vkind num flt
  | C__vkind__Embed : aspect_ratio:(e_image_aspect) -> permissions:(list (e_embed_permission)) -> src:(u_binding__str num flt) -> title:(u_text_source num flt) -> vkind num flt
  | C__vkind__ErrorBoundary : child:(node num flt) -> fallback:(node num flt) -> vkind num flt
  | C__vkind__Fact : emphasis:(bool) -> help:(option (u_text_source num flt)) -> icon:(option (string)) -> label:(u_text_source num flt) -> tone:(e_tone_variant) -> value:(u_text_source num flt) -> vkind num flt
  | C__vkind__FileUpload : accept:(list (string)) -> accept_paste:(bool) -> capture:(option (e_capture_source)) -> destination:(option (string)) -> disabled:(option (u_binding__bool num flt)) -> drop_target:(bool) -> label:(u_text_source num flt) -> max_bytes:(option (num)) -> max_files:(option (num)) -> multiple:(bool) -> on_select:(option (unit)) -> vkind num flt
  | C__vkind__Heading : level:(num) -> text:(u_text_source num flt) -> variant:(e_heading_variant) -> vkind num flt
  | C__vkind__Icon : icon:(string) -> label:(option (string)) -> size:(e_icon_size) -> tone:(e_tone_variant) -> vkind num flt
  | C__vkind__Link : download:(bool) -> href:(u_binding__str num flt) -> label:(u_text_source num flt) -> protection:(option (e_link_protection)) -> rel:(option (string)) -> target:(option (string)) -> vkind num flt
  | C__vkind__List : items:(list (u_text_source num flt)) -> ordered:(bool) -> vkind num flt
  | C__vkind__Markdown : text:(u_text_source num flt) -> vkind num flt
  | C__vkind__Math : display:(e_math_display) -> source:(string) -> vkind num flt
  | C__vkind__Progress : caveat:(option (u_text_source num flt)) -> fraction:(u_binding__flt num flt) -> indeterminate:(bool) -> label:(option (u_text_source num flt)) -> tone:(e_tone_variant) -> vkind num flt
  | C__vkind__ScrollArea : children:(list (node num flt)) -> max_height:(option (num)) -> max_width:(option (num)) -> orientation:(e_scroll_orientation) -> vkind num flt
  | C__vkind__Skeleton : rows:(num) -> vkind num flt
  | C__vkind__SplitPanel : children:(list (node num flt)) -> weight:(flt) -> vkind num flt
  | C__vkind__SummaryList : children:(list (node num flt)) -> heading:(option (u_text_source num flt)) -> vkind num flt
  | C__vkind__Toast : dismissable:(bool) -> message:(u_text_source num flt) -> open_:(u_binding__bool num flt) -> tone:(e_tone_variant) -> vkind num flt

and r_accessibility (num flt: eqtype) =
  | C__r_accessibility__Mk : described_by:(option (string)) -> hidden:(option (u_binding__bool num flt)) -> label:(option (u_binding__str num flt)) -> labelled_by:(option (string)) -> live_region:(option (e_live_region_kind)) -> role:(option (jval num flt)) -> r_accessibility num flt

and u_binding__bool (num flt: eqtype) =
  | C__u_binding__bool__Static : value:(option (bool)) -> u_binding__bool num flt
  | C__u_binding__bool__Query : depends_on:(option (list (string))) -> name:(string) -> u_binding__bool num flt
  | C__u_binding__bool__Filter : default_value:(option (bool)) -> name:(string) -> u_binding__bool num flt
  | C__u_binding__bool__Selection : default_value:(option (bool)) -> field:(option (string)) -> node_id:(string) -> u_binding__bool num flt
  | C__u_binding__bool__State : default_value:(option (bool)) -> key:(string) -> u_binding__bool num flt
  | C__u_binding__bool__Now : grain:(option (e_time_grain)) -> u_binding__bool num flt
  | C__u_binding__bool__Computed : fn:(unit) -> u_binding__bool num flt
  | C__u_binding__bool__Local : codec:(option (u_format num flt)) -> commit_to:(option (string)) -> flush_on:(u_local_flush_trigger num flt) -> format:(unit) -> initial_from:(u_binding__bool num flt) -> on_commit:(option (unit)) -> parse:(unit) -> u_binding__bool num flt
  | C__u_binding__bool__Format : format:(u_format num flt) -> locale:(u_locale_source num flt) -> source:(u_binding__flt num flt) -> u_binding__bool num flt
  | C__u_binding__bool__I18n : args:(option (list (string & u_binding__json num flt))) -> key:(string) -> u_binding__bool num flt
  | C__u_binding__bool__Transform : params:(option (list (r_transform_param num flt))) -> pipeline:(list (jval num flt)) -> source:(jval num flt) -> u_binding__bool num flt
  | C__u_binding__bool__Expr : expr:(jval num flt) -> params:(option (list (r_transform_param num flt))) -> u_binding__bool num flt
  | C__u_binding__bool__Invoke : args:(list (r_invoke_arg num flt)) -> capability_id:(string) -> u_binding__bool num flt

and u_local_flush_trigger (num flt: eqtype) =
  | C__u_local_flush_trigger__OnBlur : u_local_flush_trigger num flt
  | C__u_local_flush_trigger__OnSubmit : u_local_flush_trigger num flt
  | C__u_local_flush_trigger__OnDebounce : milliseconds:(num) -> u_local_flush_trigger num flt
  | C__u_local_flush_trigger__OnCommitAction : u_local_flush_trigger num flt

and u_format (num flt: eqtype) =
  | C__u_format__Number : decimals:(option (num)) -> u_format num flt
  | C__u_format__Currency : iso_code:(string) -> u_format num flt
  | C__u_format__Percent : decimals:(option (num)) -> u_format num flt
  | C__u_format__Date : date_style:(option (e_date_style)) -> time_style:(option (e_time_style)) -> u_format num flt
  | C__u_format__RelativeTime : unit_:(e_relative_time_unit) -> u_format num flt
  | C__u_format__Duration : style:(e_duration_style) -> unit_:(e_duration_unit) -> u_format num flt
  | C__u_format__Since : unit_:(option (e_relative_time_unit)) -> u_format num flt

and u_binding__flt (num flt: eqtype) =
  | C__u_binding__flt__Static : value:(option (flt)) -> u_binding__flt num flt
  | C__u_binding__flt__Query : depends_on:(option (list (string))) -> name:(string) -> u_binding__flt num flt
  | C__u_binding__flt__Filter : default_value:(option (flt)) -> name:(string) -> u_binding__flt num flt
  | C__u_binding__flt__Selection : default_value:(option (flt)) -> field:(option (string)) -> node_id:(string) -> u_binding__flt num flt
  | C__u_binding__flt__State : default_value:(option (flt)) -> key:(string) -> u_binding__flt num flt
  | C__u_binding__flt__Now : grain:(option (e_time_grain)) -> u_binding__flt num flt
  | C__u_binding__flt__Computed : fn:(unit) -> u_binding__flt num flt
  | C__u_binding__flt__Local : codec:(option (u_format num flt)) -> commit_to:(option (string)) -> flush_on:(u_local_flush_trigger num flt) -> format:(unit) -> initial_from:(u_binding__flt num flt) -> on_commit:(option (unit)) -> parse:(unit) -> u_binding__flt num flt
  | C__u_binding__flt__Format : format:(u_format num flt) -> locale:(u_locale_source num flt) -> source:(u_binding__flt num flt) -> u_binding__flt num flt
  | C__u_binding__flt__I18n : args:(option (list (string & u_binding__json num flt))) -> key:(string) -> u_binding__flt num flt
  | C__u_binding__flt__Transform : params:(option (list (r_transform_param num flt))) -> pipeline:(list (jval num flt)) -> source:(jval num flt) -> u_binding__flt num flt
  | C__u_binding__flt__Expr : expr:(jval num flt) -> params:(option (list (r_transform_param num flt))) -> u_binding__flt num flt
  | C__u_binding__flt__Invoke : args:(list (r_invoke_arg num flt)) -> capability_id:(string) -> u_binding__flt num flt

and u_locale_source (num flt: eqtype) =
  | C__u_locale_source__Ambient : u_locale_source num flt
  | C__u_locale_source__Explicit : tag:(string) -> u_locale_source num flt

and u_binding__json (num flt: eqtype) =
  | C__u_binding__json__Static : value:(option (jval num flt)) -> u_binding__json num flt
  | C__u_binding__json__Query : depends_on:(option (list (string))) -> name:(string) -> u_binding__json num flt
  | C__u_binding__json__Filter : default_value:(option (jval num flt)) -> name:(string) -> u_binding__json num flt
  | C__u_binding__json__Selection : default_value:(option (jval num flt)) -> field:(option (string)) -> node_id:(string) -> u_binding__json num flt
  | C__u_binding__json__State : default_value:(option (jval num flt)) -> key:(string) -> u_binding__json num flt
  | C__u_binding__json__Now : grain:(option (e_time_grain)) -> u_binding__json num flt
  | C__u_binding__json__Computed : fn:(unit) -> u_binding__json num flt
  | C__u_binding__json__Local : codec:(option (u_format num flt)) -> commit_to:(option (string)) -> flush_on:(u_local_flush_trigger num flt) -> format:(unit) -> initial_from:(u_binding__json num flt) -> on_commit:(option (unit)) -> parse:(unit) -> u_binding__json num flt
  | C__u_binding__json__Format : format:(u_format num flt) -> locale:(u_locale_source num flt) -> source:(u_binding__flt num flt) -> u_binding__json num flt
  | C__u_binding__json__I18n : args:(option (list (string & u_binding__json num flt))) -> key:(string) -> u_binding__json num flt
  | C__u_binding__json__Transform : params:(option (list (r_transform_param num flt))) -> pipeline:(list (jval num flt)) -> source:(jval num flt) -> u_binding__json num flt
  | C__u_binding__json__Expr : expr:(jval num flt) -> params:(option (list (r_transform_param num flt))) -> u_binding__json num flt
  | C__u_binding__json__Invoke : args:(list (r_invoke_arg num flt)) -> capability_id:(string) -> u_binding__json num flt

and r_transform_param (num flt: eqtype) =
  | C__r_transform_param__Mk : from:(u_binding__json num flt) -> name:(string) -> r_transform_param num flt

and r_invoke_arg (num flt: eqtype) =
  | C__r_invoke_arg__Mk : addr:(string) -> value:(string) -> r_invoke_arg num flt

and u_binding__str (num flt: eqtype) =
  | C__u_binding__str__Static : value:(option (string)) -> u_binding__str num flt
  | C__u_binding__str__Query : depends_on:(option (list (string))) -> name:(string) -> u_binding__str num flt
  | C__u_binding__str__Filter : default_value:(option (string)) -> name:(string) -> u_binding__str num flt
  | C__u_binding__str__Selection : default_value:(option (string)) -> field:(option (string)) -> node_id:(string) -> u_binding__str num flt
  | C__u_binding__str__State : default_value:(option (string)) -> key:(string) -> u_binding__str num flt
  | C__u_binding__str__Now : grain:(option (e_time_grain)) -> u_binding__str num flt
  | C__u_binding__str__Computed : fn:(unit) -> u_binding__str num flt
  | C__u_binding__str__Local : codec:(option (u_format num flt)) -> commit_to:(option (string)) -> flush_on:(u_local_flush_trigger num flt) -> format:(unit) -> initial_from:(u_binding__str num flt) -> on_commit:(option (unit)) -> parse:(unit) -> u_binding__str num flt
  | C__u_binding__str__Format : format:(u_format num flt) -> locale:(u_locale_source num flt) -> source:(u_binding__flt num flt) -> u_binding__str num flt
  | C__u_binding__str__I18n : args:(option (list (string & u_binding__json num flt))) -> key:(string) -> u_binding__str num flt
  | C__u_binding__str__Transform : params:(option (list (r_transform_param num flt))) -> pipeline:(list (jval num flt)) -> source:(jval num flt) -> u_binding__str num flt
  | C__u_binding__str__Expr : expr:(jval num flt) -> params:(option (list (r_transform_param num flt))) -> u_binding__str num flt
  | C__u_binding__str__Invoke : args:(list (r_invoke_arg num flt)) -> capability_id:(string) -> u_binding__str num flt

and r_state_behaviour (num flt: eqtype) =
  | C__r_state_behaviour__Mk : on_empty:(option (node num flt)) -> on_error:(option (unit)) -> on_loading:(option (node num flt)) -> r_state_behaviour num flt

and r_semantic_style (num flt: eqtype) =
  | C__r_semantic_style__Mk : direction:(e_text_direction) -> emphasis:(e_emphasis) -> role:(e_style_role) -> tone:(e_tone_variant) -> voice:(e_font_voice) -> weight:(e_style_weight) -> r_semantic_style num flt

and u_text_source (num flt: eqtype) =
  | C__u_text_source__Literal : text:(string) -> u_text_source num flt
  | C__u_text_source__Bound : binding:(u_binding__str num flt) -> u_text_source num flt
  | C__u_text_source__I18n : args:(list (string & jval num flt)) -> key:(string) -> u_text_source num flt

(* ======================================================================================
   3. The encoder — the discriminated envelope, keys in the vocabulary's canonical
      order. The model has no render step, so the object LITERAL is the canonical form.
      Recursion is on the MODEL value, where F*'s subterm order spans the whole family.
   ====================================================================================== *)

let rec enc_node (#num #flt: eqtype) (x: node num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__node__Node i k e0 e1 e2 e3 e4 ->
    JObj (("id", JStr i) :: ("kind", enc_vkind k) :: (match e0 with | None -> (match e1 with | None -> (match e2 with | None -> (match e3 with | None -> (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: []) | Some w -> ("tooltip", enc_u_text_source w) :: (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: [])) | Some w -> ("style", enc_r_semantic_style w) :: (match e3 with | None -> (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: []) | Some w -> ("tooltip", enc_u_text_source w) :: (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: []))) | Some w -> ("state", enc_r_state_behaviour w) :: (match e2 with | None -> (match e3 with | None -> (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: []) | Some w -> ("tooltip", enc_u_text_source w) :: (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: [])) | Some w -> ("style", enc_r_semantic_style w) :: (match e3 with | None -> (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: []) | Some w -> ("tooltip", enc_u_text_source w) :: (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: [])))) | Some w -> ("accessibility", enc_r_accessibility w) :: (match e1 with | None -> (match e2 with | None -> (match e3 with | None -> (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: []) | Some w -> ("tooltip", enc_u_text_source w) :: (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: [])) | Some w -> ("style", enc_r_semantic_style w) :: (match e3 with | None -> (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: []) | Some w -> ("tooltip", enc_u_text_source w) :: (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: []))) | Some w -> ("state", enc_r_state_behaviour w) :: (match e2 with | None -> (match e3 with | None -> (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: []) | Some w -> ("tooltip", enc_u_text_source w) :: (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: [])) | Some w -> ("style", enc_r_semantic_style w) :: (match e3 with | None -> (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: []) | Some w -> ("tooltip", enc_u_text_source w) :: (match e4 with | None -> [] | Some w -> ("visible", enc_u_binding__bool w) :: []))))))

and enc_vkind (#num #flt: eqtype) (x: vkind num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__vkind__Badge f0 f1 ->
    JObj (("$type", JStr "Badge") :: ("label", enc_u_text_source f0) :: ("variant", enc_e_badge_variant f1) :: [])
  | C__vkind__Callout f0 f1 f2 f3 f4 ->
    JObj (("$type", JStr "Callout") :: ("body", enc_u_text_source f0) :: (if f1 = false then (match f2 with | None -> (match f3 with | None -> (if f4 = C__e_tone_variant__Default then [] else ("tone", enc_e_tone_variant f4) :: []) | Some w -> ("icon", JStr w) :: (if f4 = C__e_tone_variant__Default then [] else ("tone", enc_e_tone_variant f4) :: [])) | Some w -> ("heading", enc_u_text_source w) :: (match f3 with | None -> (if f4 = C__e_tone_variant__Default then [] else ("tone", enc_e_tone_variant f4) :: []) | Some w -> ("icon", JStr w) :: (if f4 = C__e_tone_variant__Default then [] else ("tone", enc_e_tone_variant f4) :: []))) else ("dismissable", JBool f1) :: (match f2 with | None -> (match f3 with | None -> (if f4 = C__e_tone_variant__Default then [] else ("tone", enc_e_tone_variant f4) :: []) | Some w -> ("icon", JStr w) :: (if f4 = C__e_tone_variant__Default then [] else ("tone", enc_e_tone_variant f4) :: [])) | Some w -> ("heading", enc_u_text_source w) :: (match f3 with | None -> (if f4 = C__e_tone_variant__Default then [] else ("tone", enc_e_tone_variant f4) :: []) | Some w -> ("icon", JStr w) :: (if f4 = C__e_tone_variant__Default then [] else ("tone", enc_e_tone_variant f4) :: [])))))
  | C__vkind__CodeBlock f0 f1 f2 f3 f4 ->
