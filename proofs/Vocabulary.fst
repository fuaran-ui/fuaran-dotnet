    if s = "AllowForms" then Ok C__e_embed_permission__AllowForms else
    if s = "AllowFullscreen" then Ok C__e_embed_permission__AllowFullscreen else
    Error ("unknown EmbedPermission: " ^ s)

type e_capture_source =
  | C__e_capture_source__Camera
  | C__e_capture_source__Microphone

let enc_e_capture_source (#num #flt: eqtype) (x: e_capture_source) : Tot (jval num flt) =
  match x with
  | C__e_capture_source__Camera -> JStr "Camera"
  | C__e_capture_source__Microphone -> JStr "Microphone"

let dec_e_capture_source (#num #flt: eqtype) (el: jval num flt) : Tot (outcome e_capture_source) =
  match as_string el with
  | Error e -> Error e
  | Ok s ->
    if s = "Camera" then Ok C__e_capture_source__Camera else
    if s = "Microphone" then Ok C__e_capture_source__Microphone else
    Error ("unknown CaptureSource: " ^ s)

