and enc_u_text_source (#num #flt: eqtype) (x: u_text_source num flt) : Tot (jval num flt) (decreases x) =
  match x with
  | C__u_text_source__Literal f0 -> JStr f0
  | C__u_text_source__Bound f0 ->
    JObj (("$type", JStr "Bound") :: ("binding", enc_u_binding__str f0) :: [])
  | C__u_text_source__I18n f0 f1 ->
    JObj (("$type", JStr "I18n") :: ("args", JObj (enc_entries_m_json f0)) :: ("key", JStr f1) :: [])

and enc_items_l_str (#num #flt: eqtype) (xs: list (string)) : Tot (list (jval num flt)) (decreases xs) =
  match xs with
  | [] -> []
  | y :: t -> JStr y :: enc_items_l_str t

and enc_items_l_json (#num #flt: eqtype) (xs: list (jval num flt)) : Tot (list (jval num flt)) (decreases xs) =
