type e_time_grain =
  | C__e_time_grain__Second
  | C__e_time_grain__Minute
  | C__e_time_grain__Hour
  | C__e_time_grain__Day

let enc_e_time_grain (#num #flt: eqtype) (x: e_time_grain) : Tot (jval num flt) =
  match x with
  | C__e_time_grain__Second -> JStr "Second"
  | C__e_time_grain__Minute -> JStr "Minute"
  | C__e_time_grain__Hour -> JStr "Hour"
  | C__e_time_grain__Day -> JStr "Day"

let dec_e_time_grain (#num #flt: eqtype) (el: jval num flt) : Tot (outcome e_time_grain) =
  match as_string el with
  | Error e -> Error e
  | Ok s ->
    if s = "Second" then Ok C__e_time_grain__Second else
    if s = "Minute" then Ok C__e_time_grain__Minute else
    if s = "Hour" then Ok C__e_time_grain__Hour else
    if s = "Day" then Ok C__e_time_grain__Day else
    Error ("unknown TimeGrain: " ^ s)

