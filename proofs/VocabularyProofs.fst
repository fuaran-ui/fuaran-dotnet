and rt_vkind__Disclosure (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Disclosure? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
