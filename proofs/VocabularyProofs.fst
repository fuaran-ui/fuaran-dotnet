and rt_vkind (#num #flt: eqtype) (x: vkind num flt) : Lemma (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 2]) =
  match x with
  | C__vkind__Badge _ _ -> rt_vkind__Badge #num #flt x
  | C__vkind__Callout _ _ _ _ _ -> rt_vkind__Callout #num #flt x
  | C__vkind__CodeBlock _ _ _ _ _ -> rt_vkind__CodeBlock #num #flt x
  | C__vkind__Disclosure _ _ _ _ _ -> rt_vkind__Disclosure #num #flt x
  | C__vkind__Embed _ _ _ _ -> rt_vkind__Embed #num #flt x
  | C__vkind__ErrorBoundary _ _ -> rt_vkind__ErrorBoundary #num #flt x
  | C__vkind__Fact _ _ _ _ _ _ -> rt_vkind__Fact #num #flt x
  | C__vkind__FileUpload _ _ _ _ _ _ _ _ _ _ _ -> rt_vkind__FileUpload #num #flt x
  | C__vkind__Heading _ _ _ -> rt_vkind__Heading #num #flt x
  | C__vkind__Icon _ _ _ _ -> rt_vkind__Icon #num #flt x
  | C__vkind__Link _ _ _ _ _ _ -> rt_vkind__Link #num #flt x
  | C__vkind__List _ _ -> rt_vkind__List #num #flt x
  | C__vkind__Markdown _ -> rt_vkind__Markdown #num #flt x
  | C__vkind__Math _ _ -> rt_vkind__Math #num #flt x
  | C__vkind__Progress _ _ _ _ _ -> rt_vkind__Progress #num #flt x
  | C__vkind__ScrollArea _ _ _ _ -> rt_vkind__ScrollArea #num #flt x
  | C__vkind__Skeleton _ -> rt_vkind__Skeleton #num #flt x
  | C__vkind__SplitPanel _ _ -> rt_vkind__SplitPanel #num #flt x
  | C__vkind__SummaryList _ _ -> rt_vkind__SummaryList #num #flt x
  | C__vkind__Toast _ _ _ _ -> rt_vkind__Toast #num #flt x

and rt_vkind__Badge (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Badge? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__Badge f0 f1 -> rt_u_text_source #num #flt f0; rt_e_badge_variant #num #flt f1

and rt_vkind__Callout (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Callout? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
  | C__vkind__Callout f0 f1 f2 f3 f4 ->
    (if f1 = false then
      (match f2 with
        | None ->
          (match f3 with
            | None ->
              (if f4 = C__e_tone_variant__Default then
                rt_vkind__Callout__p0000 #num #flt x
              else
                rt_vkind__Callout__p0001 #num #flt x
              )
            | Some _ ->
              (if f4 = C__e_tone_variant__Default then
                rt_vkind__Callout__p0010 #num #flt x
              else
                rt_vkind__Callout__p0011 #num #flt x
              )
          )
        | Some _ ->
          (match f3 with
            | None ->
              (if f4 = C__e_tone_variant__Default then
                rt_vkind__Callout__p0100 #num #flt x
              else
                rt_vkind__Callout__p0101 #num #flt x
              )
            | Some _ ->
              (if f4 = C__e_tone_variant__Default then
                rt_vkind__Callout__p0110 #num #flt x
              else
                rt_vkind__Callout__p0111 #num #flt x
              )
          )
      )
    else
      (match f2 with
        | None ->
          (match f3 with
            | None ->
              (if f4 = C__e_tone_variant__Default then
                rt_vkind__Callout__p1000 #num #flt x
              else
                rt_vkind__Callout__p1001 #num #flt x
              )
            | Some _ ->
              (if f4 = C__e_tone_variant__Default then
                rt_vkind__Callout__p1010 #num #flt x
              else
                rt_vkind__Callout__p1011 #num #flt x
              )
          )
        | Some _ ->
          (match f3 with
            | None ->
              (if f4 = C__e_tone_variant__Default then
                rt_vkind__Callout__p1100 #num #flt x
              else
                rt_vkind__Callout__p1101 #num #flt x
              )
            | Some _ ->
              (if f4 = C__e_tone_variant__Default then
                rt_vkind__Callout__p1110 #num #flt x
              else
                rt_vkind__Callout__p1111 #num #flt x
              )
          )
      )
    )

(* rt_vkind__Callout__p0000 — dismissable at its default, heading absent, icon absent, tone at its default *)
and rt_vkind__Callout__p0000 (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (match x with | C__vkind__Callout f0 f1 f2 f3 f4 -> f1 = false && None? f2 && None? f3 && f4 = C__e_tone_variant__Default | _ -> false)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 0]) =
  match x with
  | C__vkind__Callout f0 f1 f2 f3 f4 -> rt_u_text_source #num #flt f0; (match f2 with | None -> () | Some w -> rt_u_text_source #num #flt w); rt_e_tone_variant #num #flt f4

(* rt_vkind__Callout__p0001 — dismissable at its default, heading absent, icon absent, tone not at its default *)
