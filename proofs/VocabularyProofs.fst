and rt_items_l_json (#num #flt: eqtype) (acc: list (jval num flt)) (xs: list (jval num flt)) : Lemma (ensures dec_items_l_json acc (enc_items_l_json #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_items_l_json #num #flt (y :: acc) t

and rt_items_l_r_transform_param (#num #flt: eqtype) (acc: list (r_transform_param num flt)) (xs: list (r_transform_param num flt)) : Lemma (ensures dec_items_l_r_transform_param acc (enc_items_l_r_transform_param #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_r_transform_param #num #flt y; rt_items_l_r_transform_param #num #flt (y :: acc) t

and rt_items_l_r_invoke_arg (#num #flt: eqtype) (acc: list (r_invoke_arg num flt)) (xs: list (r_invoke_arg num flt)) : Lemma (ensures dec_items_l_r_invoke_arg acc (enc_items_l_r_invoke_arg #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_r_invoke_arg #num #flt y; rt_items_l_r_invoke_arg #num #flt (y :: acc) t

and rt_entries_m_u_binding__json (#num #flt: eqtype) (acc: list (string & u_binding__json num flt)) (es: list (string & u_binding__json num flt)) : Lemma (ensures dec_entries_m_u_binding__json acc (enc_entries_m_u_binding__json #num #flt es) == Ok (rev_app acc es)) (decreases %[es; 2]) =
  match es with
  | [] -> ()
  | (k, v) :: t -> rt_u_binding__json #num #flt v; rt_entries_m_u_binding__json #num #flt ((k, v) :: acc) t

and rt_entries_m_json (#num #flt: eqtype) (acc: list (string & jval num flt)) (es: list (string & jval num flt)) : Lemma (ensures dec_entries_m_json acc (enc_entries_m_json #num #flt es) == Ok (rev_app acc es)) (decreases %[es; 2]) =
  match es with
  | [] -> ()
  | (k, v) :: t -> rt_entries_m_json #num #flt ((k, v) :: acc) t

and rt_items_l_int (#num #flt: eqtype) (acc: list (num)) (xs: list (num)) : Lemma (ensures dec_items_l_int acc (enc_items_l_int #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_items_l_int #num #flt (y :: acc) t

and rt_items_l_node (#num #flt: eqtype) (acc: list (node num flt)) (xs: list (node num flt)) : Lemma (ensures dec_items_l_node acc (enc_items_l_node #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_node #num #flt y; rt_items_l_node #num #flt (y :: acc) t

and rt_items_l_e_embed_permission (#num #flt: eqtype) (acc: list (e_embed_permission)) (xs: list (e_embed_permission)) : Lemma (ensures dec_items_l_e_embed_permission acc (enc_items_l_e_embed_permission #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_e_embed_permission #num #flt y; rt_items_l_e_embed_permission #num #flt (y :: acc) t

and rt_items_l_u_text_source (#num #flt: eqtype) (acc: list (u_text_source num flt)) (xs: list (u_text_source num flt)) : Lemma (ensures dec_items_l_u_text_source acc (enc_items_l_u_text_source #num #flt xs) == Ok (rev_app acc xs)) (decreases %[xs; 2]) =
  match xs with
  | [] -> ()
  | y :: t -> rt_u_text_source #num #flt y; rt_items_l_u_text_source #num #flt (y :: acc) t

(* ======================================================================================
   3. TOTALITY. That the decoders type-check at `Tot` is the termination proof; what the
      lemma adds is that the outcome is exactly one of the two, for EVERY input — the
      failure classification is exhaustive rather than merely non-empty.
   ====================================================================================== *)

let dec_node_total (#num #flt: eqtype) (el: jval num flt)
  : Lemma (ensures (Ok? (dec_node el) \/ Error? (dec_node el)) /\
                   ~(Ok? (dec_node el) /\ Error? (dec_node el)))
  = ()

