and rt_vkind__Fact (#num #flt: eqtype) (x: vkind num flt) : Lemma (requires (C__vkind__Fact? x)) (ensures dec_vkind (enc_vkind #num #flt x) == Ok x) (decreases %[x; 1]) =
  match x with
