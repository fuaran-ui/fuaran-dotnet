<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Phase 2026 - the NODE leg of `escape-rate`. It compiles the benchmark project's own
    `EscapeRate.fs` (linked, not copied) to JavaScript and runs it under node, so the Fable figure
    for the canonical encoder's string escape is taken by the same loop as the .NET one. Run it with
    ./run-escape-node.ps1 beside this file.

    Deliberately NOT in Fuaran.sln and NOT in the gate, the posture of tests/pure-tier-laws: it
    needs a Node runtime, and a timing is a reading, not an assertion. Nullness is off for the reason
    tests/fable-laws/FableLaws.fsproj gives (the entry project's properties govern the whole
    transpiled graph, and the wire encoder's nullness-on output does not import under node).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\EscapeRate.fs" Link="EscapeRate.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\..\..\src\Fuaran.UI.Ops\Fuaran.UI.Ops.fsproj" />
    <ProjectReference Include="..\..\..\src\Fuaran.UI.OpStream.Abstractions\Fuaran.UI.OpStream.Abstractions.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fable.Core" />
  </ItemGroup>
</Project>
