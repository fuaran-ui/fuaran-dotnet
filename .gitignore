# Build output
bin/
obj/
output/
*.fs.js
*.fs.js.map

# IDE / tooling
.vs/
.vscode/
.idea/
.ionide/
.fake/

# Per-user MSBuild and tool junk
*.user
*.orig
*.fsproj.user
*.DotSettings.user

# Node / Vite (none in session 1; first used by samples/demo in session 3b)
node_modules/
fable_modules/
dist/

# Vite dotenv files
**/.env.local
**/.env.*.local

# Claude Code per-machine settings + worktrees
.claude/worktrees/
.claude/settings.local.json
# Browser-preview launcher config — machine-local unless deliberately committed
.claude/launch.json

# Local NuGet drop folder produced by `dotnet run -- Pack` (consumer-local).
# Fuaran packs into the workspace-level ../local-nuget-feed/, not here, so this
# is defensive only.
local-nuget-feed/

# BenchmarkDotNet run output (logs + reports), produced under the repo root by
# a `dotnet run` against benchmarks/Fuaran.UI.Ops.Benchmarks. Machine-specific;
# the committed baseline JSON is the durable artifact, not these reports.
BenchmarkDotNet.Artifacts/

# Generated by tests/pure-tier-laws/run-pure-tier-laws.ps1 from the shared wire-format corpus.
# Regenerated on every run so both pipelines compile in the same bytes; never committed.
tests/pure-tier-laws/Corpus.g.fs
tests/pure-tier-laws/out/
tests/pure-tier-laws/laws-dotnet.txt
tests/pure-tier-laws/laws-fable.txt
