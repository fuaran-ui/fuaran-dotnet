<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.UI.Design.Seam</PackageId>
    <Description>The design-provider seam of Fuaran UI: the records a design tool and the language exchange (a design-system reference, a design brief with a closed interaction vocabulary, a design request and a design result), their canonical wire codec, and the IDesignProvider interface. A provider is certified by round-tripping the design/ conformance family. FSharp.Core and Fuaran.Core.Wire only; Fable-portable. Apache-2.0 licensed.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fuaran;design-system;design-tool;seam;conformance;fable</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- Phase 2295: the records are split from Fuaran.UI.Design, which renders and is .NET-only,
       so that they ship their sources under fable/ and the Fable stage compiles them with no
       exemption (the Telemetry.Abstractions convention). -->
  <ItemGroup>
    <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Seam.fs" />
    <Compile Include="SeamCodec.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fuaran.Core.Wire" />
  </ItemGroup>
</Project>
