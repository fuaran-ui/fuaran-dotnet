<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Phase 1647 - the ONE corpus-root resolver, DECLARED ONCE at tests/corpus-root/CorpusRoot.fs
         and linked (not copied) into every suite that reads the shared wire-format-fixtures corpus,
         so a git worktree resolves it through FUARAN_WIRE_FIXTURES rather than skipping silently.
         Must compile FIRST: the resolvers below delegate to it. -->
    <Compile Include="..\..\tests\corpus-root\CorpusRoot.fs" Link="CorpusRoot.fs" />    <Compile Include="FastPathTests.fs" />
    <Compile Include="GoldensTests.fs" />
    <!-- Phase 1478: the Core conformance kit's function-registry, capability,
         composition, verification and memo families over this tier's own
         artifact witness, egress gate and memo-key encoder — plus the
         host-neutral vector export the other wire hosts run. -->
    <Compile Include="CoreLawSupport.fs" />
    <Compile Include="LawVectorExport.fs" />
    <Compile Include="CoreFunctionLawTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.FastPath\Fuaran.UI.FastPath.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="FSharp.Core" />
    <!-- Phase 1478: the Core conformance kit (test-only — CoreFunctionLawTests.fs). -->
    <PackageReference Include="Fuaran.Core.Conformance" />
  </ItemGroup>
</Project>
