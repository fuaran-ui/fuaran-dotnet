<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Copy the reference CSS to the test bin so ThemeTests.fs
       can read it at runtime and assert byte-for-byte parity against
       Theme.toCss Defaults.theme. -->
  <ItemGroup>
    <Content Include="..\Fuaran.UI.Renderer\content\fuaran-reference.css">
      <Link>fuaran-reference.css</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Phase 431: the renderer sources are an INPUT to CssCoverageTests.fs, which
       reads the structural class vocabulary out of the emission sites rather
       than from a hand-transcribed list. Copied into the bin (rather than
       resolved by climbing to the repo root) so the scan cannot read a
       different checkout's sources than the ones this build compiled. The
       globs are deliberate: a new renderer source file enters the scan with no
       edit here, which is the whole forward-coupling property. -->
  <ItemGroup>
    <Content Include="..\Fuaran.UI.Renderer.Core\*.fs">
      <Link>renderer-sources\core\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Fuaran.UI.Renderer\*.fs">
      <Link>renderer-sources\client\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Fuaran.UI.Renderer.Server\*.fs">
      <Link>renderer-sources\server\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Tests.fs" />
    <Compile Include="BoundedTests.fs" />
    <!-- Phase 437: UTF-8 / base64url / raw-DEFLATE byte substrate. -->
    <Compile Include="CompressionTests.fs" />
    <Compile Include="PreEmitValidateTests.fs" />
    <Compile Include="I18nTests.fs" />
    <Compile Include="FormatBindingTests.fs" />
    <Compile Include="AccessibilityTests.fs" />
    <!-- IdsTests pins Phase 138's deterministic correlation-id swap
         (Ids.deterministicCorrelationId) — same-seed-stable, the unit floor
         for "identical trees render byte-identical output". -->
    <Compile Include="IdsTests.fs" />
    <Compile Include="ToneClassEmissionTests.fs" />
    <Compile Include="MotionEmissionTests.fs" />
    <Compile Include="CustomRendererTests.fs" />
    <!-- CustomContractTests pins Phase 164's typed Custom-payload contract:
         the Fable-safe SHA-256 vs the BCL oracle, body-shape-hash validator
         parity, hash derivation stability/sensitivity, the typed constructor's
         stamping, and the encode→decode round-trip + failure. -->
    <Compile Include="CustomContractTests.fs" />
    <Compile Include="CustomRegistryTests.fs" />
    <Compile Include="LocalBindingTests.fs" />
    <Compile Include="ClipboardActionTests.fs" />
    <Compile Include="ReadFileBodyActionTests.fs" />
    <!-- DispatchGateTests pins Phase 119's IFuaranRuntime.CanDispatch seam
         via Render.applyDispatchGate (allow-by-default + deny path). -->
    <Compile Include="DispatchGateTests.fs" />
    <!-- Phase 889: the client-side gate OUTCOMES the user-action record is
         built from, plus the cross-tier correlation-key pin. -->
    <Compile Include="ActionInvocationClientTests.fs" />
    <Compile Include="CustomIsolationTests.fs" />
    <!-- DebugGlobalTests pins Phase 90's window.__fuaran introspection surface
         (the pure, both-pipelines helpers: kindName / extractBindingSlots /
         resolveSlot / childNodes + the applyGateDecision default-deny gate).
         The live cross-host browser assertion is the env-gated tail. -->
    <Compile Include="DebugGlobalTests.fs" />
    <!-- Phase 739 — the committed-tree-change hub + the DevTools relay page
         peer (profile relay@1.0). RelayTests pins the parts a corpus of
         exchanges cannot reach (coalescing, the two postures of "off", the
         CAPABILITY_ABSENT/UNKNOWN_MESSAGE distinction, silence, and the wire
         kind-discriminator drift guard against the canonical encoder);
         RelayCorpusTests is the F# leg of the cross-host conformance gate,
         driving every fixture in wire-format-fixtures/devtools-relay/ through
         the peer. Both run without a browser, because everything but the
         postMessage transport is pure F#. -->
    <Compile Include="RelayTests.fs" />
    <Compile Include="RelayCorpusTests.fs" />
    <!-- The declared-affordance provider seam (Affordances.fs) and the relay's
         `read.affordances` entry point (relay@1.1). Pins the seam's three
         owned properties (total / filtered / isolated), the wire projection of
         every declared part, deny-by-absence for an unknown-or-withheld module
         id, and — the part a minor bump lives or dies on — that a relay@1.0
         client is still SERVED at 1.0 and is neither offered nor served the 1.1
         entry point. Sequenced: the provider registry is page-global. -->
    <Compile Include="AffordancesTests.fs" />
    <Compile Include="SanitizeTests.fs" />
    <Compile Include="SanitizationCorpusTests.fs" />
    <!-- MarkdownTests pins Phase 292's deterministic GFM renderer
         (Fuaran.UI.Renderer.Markdown.toHtml) — the canonical-HTML contract
         every host reproduces byte-exact; the same pairs seed the cross-host
         markdown conformance corpus. -->
    <Compile Include="MarkdownTests.fs" />
    <!-- MarkdownCorpusTests is the F# leg of the cross-host markdown-render
         conformance gate: it pins the workspace-root corpus
         (wire-format-fixtures/markdown/corpus.json) to the F# reference
         renderer, so TS/Python hosts running the same corpus prove byte-parity. -->
    <Compile Include="MarkdownCorpusTests.fs" />
    <Compile Include="ErrorBoundaryTests.fs" />
    <!-- FragmentTests asserts against the renderer's
         nodeKindName projection, the PreEmitValidate FragmentDecl body
         walker, and the apply engine's UpdateProp "Name" support for
         FragmentDecl + FragmentRef. -->
    <Compile Include="FragmentTests.fs" />
    <!-- ParamFragmentTests pins the Phase 180 artifact-function core
         (Fuaran.UI.Fragment): hole declaration, signature, value-space
         validation, currying, totality, effect-class join. -->
    <Compile Include="ParamFragmentTests.fs" />
    <Compile Include="FragmentApplyTests.fs" />
    <!-- FragmentMemoTests pins Phase 183's incremental re-derivation engine
         (Fuaran.UI.Memo): cache hit/miss, effecting-bypass, incremental
         value-parameter recompute (only the changed hole-address), disjoint-
         change independence, replay byte-identity, LRU eviction, observability. -->
    <Compile Include="FragmentMemoTests.fs" />
    <!-- PortableMemoTests pins Phase 360's adoption of fuaran-core#49 applyMemo:
         Fuaran.UI.Memo re-expressed over a caller-supplied content-addressed
         store (portable across session/machine via a MemoCache snapshot) rather
         than the process-local BoundedLru — portable-store round-trip, the
         effect-gate bypass, op-stream replay-through-the-store byte-parity vs
         direct replay, and canonical-JSON key parity. -->
    <Compile Include="PortableMemoTests.fs" />
    <!-- Phase 202 — RenderTiming pure-surface tests: monotonic clock, probe
         mark ordering/idempotence, node-count, aggregation (min/mean/p50/p95). -->
    <Compile Include="RenderTimingTests.fs" />
    <!-- StateReactiveTests pins Phase 106's collectStateKeys walk + the
         StateStore.subscribeKeys re-render trigger (the .NET-testable half
         of the state-channel live re-render; the React re-render itself is
         browser-only). -->
    <Compile Include="StateReactiveTests.fs" />
    <!-- WalkConformanceTests is Phase 936's executable census: one fixture per
         binding-slot class, each pinning what BindingWalk must READ and what
         Render.collectKeys must SUBSCRIBE, plus the two-sided containment
         assertion that makes a slot wired into one walk and not the other a
         red test rather than a comment violation. -->
    <Compile Include="WalkConformanceTests.fs" />
    <!-- FilterReactiveTests pins Phase 423's collectFilterKeys / filterKeysOfBinding
         walk + the FilterStore ($filters twin of StateStore) — the .NET-testable
         half of the filter-channel live re-render. -->
    <Compile Include="FilterReactiveTests.fs" />
    <!-- FormFieldWriteBackTests pins Render.pairFieldChange — the Range /
         DateRange pair-field change dispatch: a handler-free change WRITES the
         pair RECORD to the field's own State/Filter slot (the regressed Range
         shape passed None, the write-back CLEAR, erasing the slot). -->
    <Compile Include="FormFieldWriteBackTests.fs" />
    <!-- SubmitPayloadTests pins Phase 820's client-tier submit-payload core
         (Renderer.Core SubmitPayload): the declared-field harvest, the Notify
         "fields" merge (authored key wins, scalar untouched), and the
         Chain-recursive onSubmit rewrite. -->
    <Compile Include="SubmitPayloadTests.fs" />
    <!-- TransformParamTests pins Phase 424's parameterised Binding.Transform:
         param → env resolution, the unset-filter prune rule, and the derived
         Transform.paramsOf edge. -->
    <Compile Include="TransformParamTests.fs" />
    <!-- TransformScalarTests pins Phase 632's Transform-in-scalar-slots rule
         (1×1 cell, loud N×M didactic, count-of-nothing = 0) + Selection.field. -->
    <Compile Include="TransformScalarTests.fs" />
    <!-- QueryDependsOnTests pins Phase 421's Binding.Query dependsOn edge +
         the decoded-accessor identity fix (host queryResults flow through). -->
    <Compile Include="QueryDependsOnTests.fs" />
    <!-- SelectionLoopTests pins Phase 427's SelectionStore + decoded Selection
         identity accessor + the Selection reactivity channel. -->
    <Compile Include="SelectionLoopTests.fs" />
    <!-- CallResultTargetTests pins Phase 428's QueryStore + the Query reactivity channel. -->
    <Compile Include="CallResultTargetTests.fs" />
    <!-- FilterWiringValidateTests pins the consolidated 421/424/425 validator
         follow-up (FUARAN074-078 over BindingWalk). -->
    <Compile Include="FilterWiringValidateTests.fs" />
    <!-- DeadOnDecodeTests pins Phase 430's slot capability table + lint. -->
    <Compile Include="DeadOnDecodeTests.fs" />
    <!-- Phase 924 — the decode-side inertness report, and (the load-bearing
         half) the two-way completeness seam that keeps its verdict table keyed
         by names WireSurvivability and SlotCapability own. -->
    <Compile Include="AffordanceInertnessTests.fs" />
    <!-- GridDisplayTests pins Phase 425's row-field projection contract. -->
    <Compile Include="GridDisplayTests.fs" />
    <Compile Include="GridReorderTests.fs" />
    <!-- StateStoreScopingTests pins Phase 128's reset () test-isolation seam
         (clears the single-process store + subscriber list between cases). -->
    <Compile Include="StateStoreScopingTests.fs" />
    <!-- Sample themes (Fuaran.Samples.Themes.*) live under
         samples/themes/ per the phase contract; compile-checking them via
         the test project means they never bitrot, without adding a
         separate .fsproj to the solution. -->
    <Compile Include="..\..\samples\themes\Default.fs">
      <Link>SampleThemes\Default.fs</Link>
    </Compile>
    <Compile Include="..\..\samples\themes\Dark.fs">
      <Link>SampleThemes\Dark.fs</Link>
    </Compile>
    <Compile Include="..\..\samples\themes\HighContrast.fs">
      <Link>SampleThemes\HighContrast.fs</Link>
    </Compile>
    <Compile Include="ThemeTests.fs" />
    <!-- Phase 431 — the emitted-class -> reference-CSS-rule coverage floor.
         ThemeTests pins the `:root` VARIABLE surface against the typed Theme;
         this pins the CLASS surface against the rules, which was the one axis
         of the styling contract with no executable guarantee. -->
    <Compile Include="CssCoverageTests.fs" />
    <!-- CoreAdoptionTests validates the Fuaran.UI tree witness + op-stream against
         the Fuaran.Core conformance kit and re-expresses the op-stream over
         Fuaran.Core.OpStream (with a canonical-encoding equality wrapper, since
         Node carries handler closures and is not an F# equality type). -->
    <Compile Include="CoreAdoptionTests.fs" />
    <Compile Include="MathEnhanceTests.fs" />
    <Compile Include="MathMlTests.fs" />
    <!-- QueryBindingTests pins Phase 323's runtime query-result-schema →
         Binding<'T> typed-thread check (Fuaran.UI.QueryBinding): the pure
         default-deny compatibility relation + the schema↔binding walk that
         rejects a string column bound into a numeric sink (FUARAN066) / an
         absent column (FUARAN067), and types a schema-only zero-row dashboard. -->
    <Compile Include="QueryBindingTests.fs" />
    <!-- QuerySourceTests pins Phase 323 task 1 + the Phase 324 typed core: the
         async IClientQuerySource seam + resolveAndCheck gate (a type-mismatched
         dashboard never renders) + the schema-only privacy path (types a
         dashboard with zero rows crossing the boundary). -->
    <Compile Include="QuerySourceTests.fs" />
    <!-- QueryRefineTests pins Phase 324 task 4: client-side refinement via the
         Fuaran.Core.DataFrame evaluator over already-fetched rows (sort/filter/
         project), re-typed against the dashboard, with zero re-query. -->
    <Compile Include="QueryRefineTests.fs" />
    <!-- RetrievalSourceTests pins Phase 325 core: the IClientRetrievalSource seam
         + canonical hitSchema + hit→Table projection, and proves retrieval hits
         type-check through the SAME QueryBinding thread as relational rows (one
         UI contract for both data planes). -->
    <Compile Include="RetrievalSourceTests.fs" />
    <!-- Phase 268: Node.mapMsg — structural relabel of a tree's message type
         (the erasure `embed` lowers through). Pins every remapped Action slot. -->
    <Compile Include="NodeMapTests.fs" />
    <Compile Include="WireSurvivabilityTests.fs" />
    <Compile Include="ChartLoweringTests.fs" />
    <!-- Phase 643 — the provenance stamp + self-describing SVG. Reads the
         copied renderer sources above for the SSR/CSR "one entry point" lock. -->
    <Compile Include="ChartProvenanceTests.fs" />
    <!-- Phase 790 — the resource bounds a well-formed emission can otherwise
         exhaust slowly: portable-memo-store eviction and the chart-lowering
         series / point caps + the linear-not-quadratic property. -->
    <Compile Include="CostBoundsTests.fs" />
    <!-- Phase 671: the IDL-generated structural layer, byte-diffed tier-side. -->
    <Compile Include="GeneratedLayerTests.fs" />
    <Compile Include="HandlerAddressTests.fs" />
    <!-- RenderEntrySeamTests pins the two Custom-node hosting gaps: the
         scope × telemetry-sink render entry (renderWithSourcesInScopeAndSink —
         a scoped host no longer trades render-failure telemetry for state
         isolation), and the Mount arm's host-pluggable GuestSeam (a RENDERED
         guest passes the host's capability policy, not just an
         orchestration-driven one). -->
    <Compile Include="RenderEntrySeamTests.fs" />
    <!-- Phase 443 — the structural predicate library over Node trees: the five
         query classes over the shared corpus, the algebra laws by exhaustive
         enumeration, and the delegation seam onto the shipped
         signature-searchable pattern bank (which the predicate library composes
         with and never reimplements). -->
    <Compile Include="StructuralQueryTests.fs" />
    <!-- Phase 897 — the destination policy beside the scheme floor: whether a
         URL is safe to HAVE is a different question from whether its
         destination was DECLARED. -->
    <Compile Include="EgressPolicyTests.fs" />
    <!-- Phase 1106 — the Defaults-`with` construction discipline. Reads the
         authoring sites (every test project, samples/, benchmarks/) and fails on
         a full spec-record literal that has not declared itself deliberate, so
         an additive wire slot stops breaking (FS0764) every literal in the repo.
         The governed spec set is derived from Defaults.fs, so a new spec is
         governed the moment it gains a default. -->
    <Compile Include="SpecConstructionTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Charts\Fuaran.UI.Charts.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Renderer\Fuaran.UI.Renderer.fsproj" />
    <!-- FragmentTests exercises Ops.Apply +
         Ops.Introspect for FragmentDecl / FragmentRef UpdateProp paths. -->
    <ProjectReference Include="..\Fuaran.UI.Ops\Fuaran.UI.Ops.fsproj" />
    <!-- ErrorBoundaryTests asserts against
         RenderFailureTelemetry records via an inline IFuaranTelemetrySink
         implementation. -->
    <ProjectReference Include="..\Fuaran.UI.Telemetry.Abstractions\Fuaran.UI.Telemetry.Abstractions.fsproj" />
    <!-- Phase 183 — FragmentMemoTests exercises the incremental re-derivation
         engine + the op-stream canonical-JSON encoder it keys over. -->
    <ProjectReference Include="..\Fuaran.UI.Memo\Fuaran.UI.Memo.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.OpStream.Abstractions\Fuaran.UI.OpStream.Abstractions.fsproj" />
    <!-- Phase 443 — StructuralQueryTests wires the predicate library's
         delegation seam onto the REAL signature-searchable pattern bank, so the
         "a routed query is answered by the shipped surface" claim is asserted
         against that surface rather than a stand-in. The reference runs
         tests -> bank -> tier; the tier itself still references neither. -->
    <ProjectReference Include="..\Fuaran.UI.FastPath\Fuaran.UI.FastPath.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="FSharp.Core" />
    <!-- Fuaran.Core conformance substrate (test-only — CoreAdoptionTests.fs). -->
    <PackageReference Include="Fuaran.Core.Tree" />
    <PackageReference Include="Fuaran.Core.Ops" />
    <PackageReference Include="Fuaran.Core.OpStream" />
    <PackageReference Include="Fuaran.Core.Conformance" />
  </ItemGroup>
</Project>
