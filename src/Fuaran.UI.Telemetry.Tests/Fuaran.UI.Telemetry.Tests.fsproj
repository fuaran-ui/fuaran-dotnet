<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="OpKindTests.fs" />
    <Compile Include="SinkTests.fs" />
    <!-- Phase 270 (§4o): per-guest sink resolution + scope-attributed diagnostics. -->
    <Compile Include="GuestTelemetryTests.fs" />
    <Compile Include="ConsoleDevToolsSinkTests.fs" />
    <Compile Include="ApplyTests.fs" />
    <!-- Phase 330: the runtime validate-outcome leg + the open-surface
         invariant that keeps the correlation vocabulary generic. -->
    <Compile Include="ValidateOutcomeTests.fs" />
    <Compile Include="DriftTests.fs" />
    <Compile Include="ProviderDriftTests.fs" />
    <Compile Include="StyleDriftTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Ops\Fuaran.UI.Ops.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Telemetry.Abstractions\Fuaran.UI.Telemetry.Abstractions.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Telemetry.Default\Fuaran.UI.Telemetry.Default.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Telemetry.Drift\Fuaran.UI.Telemetry.Drift.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.StyleObserver.Abstractions\Fuaran.UI.StyleObserver.Abstractions.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.ThemeManifest\Fuaran.UI.ThemeManifest.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
