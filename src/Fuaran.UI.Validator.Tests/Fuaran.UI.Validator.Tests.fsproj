<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Inherits the transitive FSharp.Compiler.Service ref from
         Fuaran.UI.Validator; same NU1608 over-strict pin applies. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Phase 2053: every source the validator tests run over is a compile item,
         so a snippet that does not type-check against Fuaran.UI breaks this build. -->
    <Compile Include="Snippets/*.fs" />
    <Compile Include="ManifestTests.fs" />
    <Compile Include="ManifestEmitterTests.fs" />
    <Compile Include="ValidatorTests.fs" />
    <Compile Include="RecipeCertificationTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.UI.Validator\Fuaran.UI.Validator.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
