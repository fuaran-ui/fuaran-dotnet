<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WireTests.fs" />
    <Compile Include="LoweringTests.fs" />
    <Compile Include="ValidationTests.fs" />
    <Compile Include="DriverTests.fs" />
    <Compile Include="ChannelTests.fs" />
    <Compile Include="FrameWireTests.fs" />
    <Compile Include="DurabilityTests.fs" />
    <Compile Include="FormValidationTests.fs" />
    <Compile Include="FormBufferTests.fs" />
    <Compile Include="NavigationTests.fs" />
    <Compile Include="InteractionTelemetryTests.fs" />
    <Compile Include="DomPatchCorpusTests.fs" />
    <!-- Phase 889: the server-driven user-action emission point (Driver.step
         + the form-submit leg's own G1 call). -->
    <Compile Include="ActionInvocationDriverTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.UI.ServerDriven\Fuaran.UI.ServerDriven.fsproj" />
    <!-- LoweringTests build Node fixtures (Fuaran.UI), construct TreeOps
         (Fuaran.UI.Ops), and exercise the diff→lower pipeline (OpStream.Replay). -->
    <ProjectReference Include="..\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Ops\Fuaran.UI.Ops.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.OpStream.Replay\Fuaran.UI.OpStream.Replay.fsproj" />
    <!-- Phase 153: BoundedActionsTests use BindingResolver.BindingSources as the store. -->
    <ProjectReference Include="..\Fuaran.UI.Renderer.Core\Fuaran.UI.Renderer.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
