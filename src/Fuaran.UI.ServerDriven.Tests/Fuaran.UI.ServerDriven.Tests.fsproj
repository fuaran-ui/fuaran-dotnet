<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WireTests.fs" />
    <Compile Include="LoweringTests.fs" />
    <Compile Include="ValidationTests.fs" />
    <Compile Include="DriverTests.fs" />
    <Compile Include="ChannelTests.fs" />
    <Compile Include="FrameWireTests.fs" />
    <Compile Include="DurabilityTests.fs" />
    <Compile Include="FormValidationTests.fs" />
    <Compile Include="FormBufferTests.fs" />
    <Compile Include="NavigationTests.fs" />
    <Compile Include="InteractionTelemetryTests.fs" />
    <Compile Include="DomPatchCorpusTests.fs" />
    <!-- Phase 889: the server-driven user-action emission point (Driver.step
         + the form-submit leg's own G1 call). -->
    <Compile Include="ActionInvocationDriverTests.fs" />
    <!-- The action-log census's server-driven leg: this tier's describers and
         the rejection strings that quote them (docs/ACTION-LOG-PRIVACY.md). -->
    <Compile Include="ActionLogCensusTests.fs" />
    <!-- Phase 1179: the live-Transform incremental seam, measured against the
         incremental-recompute conformance family's own edit streams. -->
    <Compile Include="LiveTransformCorpusTests.fs" />
    <!-- Phase 1479: the footprint and delta law families over the live-Transform
         seam — the pinned kit's own incremental and dirty-propagation families,
         and the same properties stated over THIS tier's live path. After the
         corpus tests, whose recorded vectors it reads as fixed cases. -->
    <Compile Include="CoreIncrementalLawsTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.UI.ServerDriven\Fuaran.UI.ServerDriven.fsproj" />
    <!-- LoweringTests build Node fixtures (Fuaran.UI), construct TreeOps
         (Fuaran.UI.Ops), and exercise the diff→lower pipeline (OpStream.Replay). -->
    <ProjectReference Include="..\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Ops\Fuaran.UI.Ops.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.OpStream.Replay\Fuaran.UI.OpStream.Replay.fsproj" />
    <!-- Phase 153: BoundedActionsTests use BindingResolver.BindingSources as the store. -->
    <ProjectReference Include="..\Fuaran.UI.Renderer.Core\Fuaran.UI.Renderer.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The conformance family's own bytes, vendored so these legs run in any
         clone rather than reporting themselves skipped. The reader FAILS on an
         absent directory: a conformance check that goes green without its oracle
         is worse than no check. -->
    <Content Include="fixtures\incremental-recompute\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="fixtures\incremental-recompute" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="FSharp.Core" />
    <!-- Phase 1479: the pinned Fuaran.Core conformance kit. Its incremental and
         dirty-propagation families are run in CoreIncrementalLawsTests.fs, and
         this reference is also what enrols the project in the Phase-1475 census
         scan (which discovers conformance-referencing test projects from their
         .fsproj rather than from a list). -->
    <PackageReference Include="Fuaran.Core.Conformance" />
  </ItemGroup>
</Project>
