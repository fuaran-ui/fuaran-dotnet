<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 314 — analyzer tests. A console-Exe runner (matching the repo's Expecto
       + conformance suites) that drives Fuaran.UI.Analyzers over source snippets via
       CSharpCompilation.WithAnalyzers and asserts the diagnostics — positive +
       negative per rule. Driving the analyzer directly (rather than the version-
       sensitive Microsoft.CodeAnalysis.Testing helpers) keeps the suite robust under
       the workspace's TreatWarningsAsErrors + a fast-moving net10 Roslyn. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Fuaran.UI.Analyzers.Tests</RootNamespace>
    <AssemblyName>Fuaran.UI.Analyzers.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The analyzer under test — referenced for its compile output so the test can
         instantiate it directly (it is also applied to this project as an analyzer;
         harmless, as the test embeds the analysed code as string snippets). -->
    <ProjectReference Include="..\Fuaran.UI.Analyzers\Fuaran.UI.Analyzers.csproj" />
    <!-- The veneer + its deps, so the test snippets compile against the real surface. -->
    <ProjectReference Include="..\Fuaran.UI.CSharp\Fuaran.UI.CSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
