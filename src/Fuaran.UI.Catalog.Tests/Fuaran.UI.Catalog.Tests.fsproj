<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Phase 169 — this project compile-links the catalog's Matrix.fs (the
         SAME source the gallery projects) so the wire-JSON round-trip guard
         tracks the catalog automatically. Matrix.fs lives in a Fable sample
         whose project sets <Nullable>disable</Nullable> (Feliz / Fable.Elmish
         predate F# 10's nullness checker); we mirror that posture here so the
         linked file compiles under the same rules it was authored against,
         rather than forcing nullness annotations onto a Fable-side file. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The catalog matrix, linked from the sample — the round-trip guard's
         fixture source. Matrix.fs opens only Fuaran.UI / Fuaran.UI.Types, so it
         is .NET-clean (no Fable.Core / Browser surface). -->
    <Compile Include="..\..\samples\catalog\Matrix.fs">
      <Link>Matrix.fs</Link>
    </Compile>
    <Compile Include="CatalogRoundTripTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Ops\Fuaran.UI.Ops.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.OpStream.Abstractions\Fuaran.UI.OpStream.Abstractions.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
