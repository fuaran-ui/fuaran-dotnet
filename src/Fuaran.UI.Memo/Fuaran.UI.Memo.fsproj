<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.UI.Memo</PackageId>
    <Description>Fuaran incremental re-derivation engine — effect-aware memoisation over the Phase 180 artifact-function apply. Caches substituted fragment trees keyed by (function-identity, arg-set); a value-parameter change reuses the structural tree and recomputes only the affected hole-addressed bindings; effecting functions bypass the cache; op-stream replay resolves through the cache to a byte-identical tree. Apache-2.0 licensed.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fuaran;memoisation;incremental;re-derivation;artifact-function</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- Pack source for Fable consumers under fable/ (same convention as
       Fuaran.UI). The engine is Fable-clean — CanonicalJson is Fable-compatible,
       Hashing is the Fable-safe SHA-256, FragmentApply is Fable-clean, and the
       BoundedLru uses only Dictionary + ResizeArray. -->
  <ItemGroup>
    <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
  </ItemGroup>
  <!-- Phase 1606 — the Fable portability gate derives its set from the pack path
       above, so this project is in it by default. It is held out, and the reason
       is the property's value so that an exemption without one cannot be written.
       tests/fable-laws/fable-check.ps1 prints every exemption on every run. -->
  <PropertyGroup>
    <FablePortabilityExemption>Ships fable/ sources but does not compile as a Fable ENTRY project: it references Fuaran.UI.Renderer, which sets Nullable=disable for ITSELF precisely because Feliz 3.3.3 and Fable.React are pre-F#-10-nullness libraries. Entering here compiles Renderer and Feliz under THIS project's nullness-ON settings and they fail. The wider question Phase 1606 surfaced - that a nullable-enabled consumer of the Renderer meets the same wall, so the Renderer's own entry proves less than it looks - is larger than this gate.</FablePortabilityExemption>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FragmentKey.fs" />
    <!-- Phase 360 — the caller-supplied content-addressed store (portable across
         session / machine), backed by Fuaran.Core.Function's MemoCache (applyMemo
         cache model). The default InProcessStore preserves the pre-360 BoundedLru
         behaviour; the MemoCacheStore is the portable one. -->
    <Compile Include="PortableStore.fs" />
    <Compile Include="IncrementalApply.fs" />
    <!-- Phase 360 — op-stream replay generalised to memo-served re-application:
         a recorded session replays through the store, byte-identical to direct
         replay. -->
    <Compile Include="MemoReplay.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Renderer\Fuaran.UI.Renderer.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.OpStream.Abstractions\Fuaran.UI.OpStream.Abstractions.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Telemetry.Abstractions\Fuaran.UI.Telemetry.Abstractions.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <!-- Phase 360 — adopt fuaran-core#49's applyMemo cache model: the portable
         MemoCacheStore is backed by Fuaran.Core.MemoCache<Node<'Msg>>. -->
    <PackageReference Include="Fuaran.Core.Function" />
  </ItemGroup>
</Project>
