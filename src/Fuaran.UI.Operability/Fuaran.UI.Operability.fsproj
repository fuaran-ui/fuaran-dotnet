<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.UI.Operability</PackageId>
    <Description>Fuaran operability — a tree's operable surface as a specified projection of it. A pure, total derivation from a Fuaran tree to the affordances an agent-initiated instruction may address (set, clear, click, navigate, read), and the reference matcher of the resolution contract (WIRE_FORMAT §31): deterministic, LLM-free, Fable-clean. Apache-2.0 licensed.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Operability.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- Pack source for Fable consumers under fable/ (the Fuaran.UI / Fuaran.UI.FastPath
       shape) — a PackageReference Fable consumer retranspiles from source. -->
  <ItemGroup>
    <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
  </ItemGroup>
  <ItemGroup>
    <!-- The typed tree only: the derivation reads a Node<'Msg>, and the matcher reads
         what the derivation produced. No renderer, no codec, no host. -->
    <ProjectReference Include="..\Fuaran.UI\Fuaran.UI.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
