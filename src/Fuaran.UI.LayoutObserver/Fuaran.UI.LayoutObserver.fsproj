<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.UI.LayoutObserver</PackageId>
    <Description>Fuaran layout-observability concrete observers — BrowserLayoutObserver (Fable, ResizeObserver-backed, rAF-debounced) and InMemoryLayoutObserver (pure .NET, drives Expecto tests + the eval gate). Companion of Fuaran.UI.LayoutObserver.Abstractions; shares all flag-derivation logic. Apache-2.0 licensed.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fuaran;layout;observability;ai;resize-observer</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- Pack source for Fable consumers under fable/. Browser-only
       code is guarded inside BrowserLayoutObserver.fs with
       #if FABLE_COMPILER. -->
  <ItemGroup>
    <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
  </ItemGroup>
  <!-- Phase 1606 — the Fable portability gate derives its set from the pack path
       above, so this project is in it by default. It is held out, and the reason
       is the property's value so that an exemption without one cannot be written.
       tests/fable-laws/fable-check.ps1 prints every exemption on every run. -->
  <PropertyGroup>
    <FablePortabilityExemption>Ships fable/ sources but does not compile as a Fable ENTRY project as it stands: BrowserLayoutObserver.fs's #if FABLE_COMPILER arm opens Browser.Dom / Browser.Types while this project references no Fable.Browser.Dom (a consumer supplies it), and the same arm carries three F# 10 nullness errors under this project's own nullness-ON settings. Adding that PackageReference changes the published dependency set, so it is a deliberate versioned act rather than a gate fix. Phase 1606.</FablePortabilityExemption>
  </PropertyGroup>
  <ItemGroup>
    <!-- The three-way meaning of registering one node id: fresh, unchanged,
         or a REMOUNT under the same id. Outside the observer's
         `#if FABLE_COMPILER` branch so the rule is assertable on .NET. -->
    <Compile Include="ElementRegistration.fs" />
    <Compile Include="InMemoryLayoutObserver.fs" />
    <Compile Include="BrowserLayoutObserver.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.UI.LayoutObserver.Abstractions\Fuaran.UI.LayoutObserver.Abstractions.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Phase 322 — InMemoryLayoutObserver is a domain instance of the generic
         Fuaran.Core.Observer runtime-verification seam. Source-packed for the Fable client. -->
    <PackageReference Include="Fuaran.Core.Observer" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fable.Core" />
  </ItemGroup>
</Project>
