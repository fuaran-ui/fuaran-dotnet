<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.UI</PackageId>
    <Description>Fuaran – AI-emittable F# UI language. An emission is bounded data over a closed vocabulary rather than code or markup, so a malformed tree is a typed refusal with a stable code and a path rather than a plausible-looking render. Fuaran.UI.WireLimits expresses the wire format's normative resource limits (node depth, JSON depth, string and array length, total node count) that keep a decode of untrusted input bounded. Apache-2.0 licensed.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- Pack source for Fable consumers under fable/. The LayoutObserver
       packages had this already, but Fuaran.UI + Fuaran.UI.Renderer
       (the foundations) shipped DLL-only, breaking PackageReference Fable
       consumers. -->
  <ItemGroup>
    <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
  </ItemGroup>
  <ItemGroup>
    <!-- Stage 1 of the 692-694 swap: the generated structural layer compiles FIRST
         so Types.fs can alias its vocabulary (type abbreviations over
         Fuaran.UI.Generated). Generated.fs depends only on Fuaran.Core. -->
    <Compile Include="HostPrelude.fs" />
    <!-- Phase 781: the decode-side resource limits (max node depth / JSON depth /
         string length / array length / node count) every walk in the stack is
         bounded by. Literals only — depends on nothing, so it compiles first and
         is visible to Ops, Renderer.Server and ServerDriven alike. -->
    <Compile Include="WireLimits.fs" />
    <Compile Include="StateKeyPolicy.fs" />
    <Compile Include="Generated.fs" />
    <Compile Include="Types.fs" />
    <!-- Phase 268: Node.mapMsg — exhaustive ('a -> 'b) -> Node<'a> -> Node<'b>
         relabel of a tree's message type (the erasure `embed` lowers through).
         Depends only on Types.fs. -->
    <Compile Include="NodeMap.fs" />
    <Compile Include="Hashing.fs" />
    <!-- Phase 437: pure Fable-safe UTF-8 / base64url / raw-DEFLATE — the
         teleport state-bundle codec's byte substrate (same cross-pipeline
         byte-parity posture as Hashing.fs). Depends on FSharp.Core only. -->
    <Compile Include="Compression.fs" />
    <Compile Include="Bounded.fs" />
    <Compile Include="Defaults.fs" />
    <Compile Include="Fragment.fs" />
    <Compile Include="FragmentMemo.fs" />
    <Compile Include="Fuaran.fs" />
    <Compile Include="CustomContract.fs" />
    <Compile Include="CustomRegistry.fs" />
    <!-- Phase 427: the cross-tree binding-collection walk PreEmitValidate's
         tree-wide checks (dangling Selection; the 421/424/425 filter
         consumption union) run on. Depends only on Types.fs. -->
    <Compile Include="BindingWalk.fs" />
    <Compile Include="PreEmitValidate.fs" />
    <!-- Phase 430: the slot capability table + the dead-on-decode lint (the
         declarative-floor un-regression pair). Depend only on Types.fs. -->
    <Compile Include="SlotCapability.fs" />
    <Compile Include="WireSurvivability.fs" />
    <Compile Include="DeadOnDecode.fs" />
    <!-- Phase 442: the per-NodeKind render-fidelity declaration (which tiers
         exist, what the parity-checked fallback pins, what is declared
         client-only rich) + the badge derivation consumers read instead of
         hand-annotating. Depends only on Types.fs. -->
    <Compile Include="RenderFidelity.fs" />
    <Compile Include="QueryBinding.fs" />
    <Compile Include="QuerySource.fs" />
    <Compile Include="QueryRefine.fs" />
    <Compile Include="RetrievalSource.fs" />
    <!-- Structural predicates over decoded `Node` trees — the query surface for
         searching a CORPUS of applications (kind / binding / shape / style /
         behaviour terms, and/or/not, descendant + ancestor scoping, match
         traces). Reads `Types.fs` and reuses `BindingWalk.fs` for the binding
         class rather than re-walking the spec vocabulary; holds no signature
         search of its own (see the module's `Delegation`). -->
    <Compile Include="StructuralQuery.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <!-- Canonical JSON AST (JVal): Custom props / action payloads / I18n args carry it
         directly in the type contract. Fable-distributed (source-packed). -->
    <PackageReference Include="Fuaran.Core.Wire" />
    <!-- Phase 671: the IDL-generated structural layer's plumbing binds a
         Core NodeWitness and a runValidator scaffold. -->
    <PackageReference Include="Fuaran.Core.Tree" />
    <PackageReference Include="Fuaran.Core.Validator" />
    <!-- Compute layer (Phase 282): the Binding.Transform case carries Fuaran.Core's columnar +
         dataframe types. Fable-distributed (source-packed), so the Fable client compiles them. -->
    <PackageReference Include="Fuaran.Core.Column" />
    <PackageReference Include="Fuaran.Core.DataFrame" />
  </ItemGroup>
</Project>
