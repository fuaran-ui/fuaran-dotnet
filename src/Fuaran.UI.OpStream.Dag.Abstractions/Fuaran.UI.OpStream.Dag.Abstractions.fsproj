<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.UI.OpStream.Dag.Abstractions</PackageId>
    <Description>Fuaran op-stream branching-DAG abstractions (opt-in, rung-4). The DAG is Fuaran.Core's: a DagOpRecord is a Core DagNode over the linear chain's provenance envelope (StreamEntry), addressed by Core's Dag.nodeId under the tier's SHA-256, verified by Core's Dag.firstBreak. The IDagOpStreamSink superset interface (atomic tryAdvanceHead CAS, admission by address recompute and parent presence, a pruned-node skeleton beside the live set), the verified lift from a linear segment, and the canonical record wire form. The linear OpRecord / IOpStreamSink are untouched. Apache-2.0 licensed.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fuaran;op-stream;dag;merkle;branching;content-addressed</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- Pack source for Fable consumers under fable/ (same convention as the
       linear abstractions package). Server-only types (SHA-256 hashing,
       DagVerify) are guarded inside the .fs files with #if !FABLE_COMPILER. -->
  <ItemGroup>
    <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="DagOpRecord.fs" />
    <Compile Include="DagVerify.fs" />
    <Compile Include="DagWriteAdmission.fs" />
    <Compile Include="DagRetention.fs" />
    <Compile Include="DagWire.fs" />
    <Compile Include="IDagOpStreamSink.fs" />
    <!-- Phase 267: guest-fork causal anchor (guest genesis = DAG child of the
         Mount creation op) + guest-op provenance projection (§4o). -->
    <Compile Include="GuestFork.fs" />
    <!-- Phase 2116: the verified lift from a linear segment to a DAG branch,
         with a receipt anyone can recompute. -->
    <Compile Include="DagLift.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Ops\Fuaran.UI.Ops.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.OpStream.Abstractions\Fuaran.UI.OpStream.Abstractions.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <!-- Phase 2645: the node, its address, its verifier, its topology, retention and replay are Core's. -->
    <PackageReference Include="Fuaran.Core.OpStream.Dag" />
  </ItemGroup>
</Project>
