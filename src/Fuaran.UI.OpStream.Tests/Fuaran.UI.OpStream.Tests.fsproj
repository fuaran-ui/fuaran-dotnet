<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TestSupport.fs" />
    <Compile Include="HashChainTests.fs" />
    <!-- Phase 409 tail: StreamEntry.decode — the inverse of the pinned
         provenance envelope, and the Core witness's decode leg. -->
    <Compile Include="StreamEntryTests.fs" />
    <Compile Include="ReplayTests.fs" />
    <!-- Phase 274 (§4o): portable guest export — OpRecordWire codec, bundle
         document round-trip, export-from-sink, remap + replay-on-import. -->
    <Compile Include="GuestExportTests.fs" />
    <Compile Include="ApplyPersistTests.fs" />
    <Compile Include="ApplyWithSinksTests.fs" />
    <!-- Phase 193: the append-only journal leg behind the in-page apply seam. -->
    <Compile Include="JournalAppliedTests.fs" />
    <Compile Include="TamperTests.fs" />
    <!-- Phase 793: the chain is verified on the READ paths (Replay + both
         linear sinks). Go-red proofs — each corrupts a real record in a real
         store, the Sqlite ones by UPDATEing the database file. -->
    <Compile Include="VerifyOnReadTests.fs" />
    <!-- Phase 789: segment attestation — descriptor corpus + forgery verdicts. -->
    <Compile Include="AttestationTests.fs" />
    <Compile Include="ConcurrencyTests.fs" />
    <Compile Include="SqliteTests.fs" />
    <Compile Include="TreeDiffTests.fs" />
    <Compile Include="TreeOpDiffTests.fs" />
    <Compile Include="CheckpointTests.fs" />
    <Compile Include="ChainMigrationTests.fs" />
    <Compile Include="ChainCorpusTests.fs" />
    <!-- Phase 437: teleport state-bundle codec. -->
    <Compile Include="TeleportTests.fs" />
    <!-- The §16 canonical-form projection across every Node-bearing op
         payload — the deterministic pin behind the probabilistic cross-host
         fuzz gate that found `stateBehaviourAppender` bypassing it. -->
    <Compile Include="CanonicalFormOpTests.fs" />
    <!-- Phase 889: the user-action record, its redaction default (the poison
         test), and its durable SQLite log. -->
    <Compile Include="ActionInvocationTests.fs" />
    <Compile Include="ActionLogPrivacyTests.fs" />
    <!-- Phase 577: the transport encoder that refuses a lossy tree. -->
    <Compile Include="TransportEncodeTests.fs" />
    <!-- Phase 1477: the Core persistence law families (casLaws / idempotencyLaws /
         snapshotLaws / snapshotLawsWith) over the tier's op-stream witness, plus
         the two durable ports' own account of the same three claims. -->
    <Compile Include="PersistenceLawsTests.fs" />
    <!-- Phase 1480: the attributed / attestation / no-attestation-vacuity families over the
         SAME witness, with the tier's real claim minting and ECDSA keyring adapted to Core's
         IAttestationSink. Compiles after PersistenceLawsTests.fs, whose witness it reuses. -->
    <Compile Include="CoreAttestationLawsTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Ops\Fuaran.UI.Ops.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.OpStream.Abstractions\Fuaran.UI.OpStream.Abstractions.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.OpStream.InMemory\Fuaran.UI.OpStream.InMemory.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.OpStream.Sqlite\Fuaran.UI.OpStream.Sqlite.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.OpStream.Replay\Fuaran.UI.OpStream.Replay.fsproj" />
    <!-- Phase 124: ApplyWithSinksTests asserts the both-sinks fan-out emits an
         IFuaranTelemetrySink record alongside the op-stream record. -->
    <ProjectReference Include="..\Fuaran.UI.Telemetry.Abstractions\Fuaran.UI.Telemetry.Abstractions.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="FSharp.Core" />
    <!-- Phase 1477: the Fuaran.Core conformance kit (test-only — PersistenceLawsTests.fs).
         Its presence here is also what enrols this project in the Core-conformance census. -->
    <PackageReference Include="Fuaran.Core.Conformance" />
  </ItemGroup>
</Project>
