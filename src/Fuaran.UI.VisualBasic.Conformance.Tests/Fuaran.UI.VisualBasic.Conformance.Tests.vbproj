<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 312 — corpus conformance for the VB XML-literal veneer. A VB console
       runner (XML literals are a VB language feature, so the authored trees must be
       VB source) wired into Build.fs Test target, corpus-gated. Seeded with smoke
       coverage in Phase 310; grown to the full corpus in Phase 312. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Fuaran.UI.VisualBasic.Conformance.Tests</RootNamespace>
    <AssemblyName>Fuaran.UI.VisualBasic.Conformance.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The VB veneer under test + the C# decode facade (Phase 309) it reuses. -->
    <ProjectReference Include="..\Fuaran.UI.VisualBasic\Fuaran.UI.VisualBasic.vbproj" />
    <ProjectReference Include="..\Fuaran.UI.CSharp\Fuaran.UI.CSharp.csproj" />
  </ItemGroup>

</Project>
