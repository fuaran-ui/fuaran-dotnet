<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.UI.OpStream.Dag.Merge</PackageId>
    <Description>The merge of the Fuaran op-stream DAG, which is Fuaran.Core's DAG over the op envelope: a thin reconciliation policy over Core's conflict report (agreement, a declared child-order rule, a reorder rebase, every other interfering pair refused with a typed envelope), an optional precedence-as-script side, the validator gate, and Core's replay, checkpoints and compaction bound to the tier. A merge node records its script and is checked to replay to the derived tree. Requires IDagOpStreamSink, so DAG behaviour is structurally unreachable from the linear path. Apache-2.0 licensed.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fuaran;op-stream;dag;merge;reconcile;content-addressed</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- Pack source for Fable consumers under fable/ (same convention as
       Fuaran.UI.Telemetry.Default). Phase 2139: offered to Fable consumers, so a
       browser host runs the merge engine from the published package rather than
       a source reference; shipping the sources also puts this project in the
       Fable stage's derived portability set, so every gate compiles it under
       Fable. tests/fable-pack-consumer/ proves the packed artefact. -->
  <ItemGroup>
    <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ValidatorGate.fs" />
    <Compile Include="BatchAccept.fs" />
    <Compile Include="DagReconcile.fs" />
    <!-- Phase 2645: the tier's binding of Core's replay, checkpoints and compaction
         (the policy's replay witness, SHA-256, the canonical tree encoding). -->
    <Compile Include="DagFold.fs" />
    <!-- Phase 267: replay a mounted guest's interior from its own stream alone,
         bounded at the Mount anchor (§4o). -->
    <Compile Include="GuestReplay.fs" />
    <Compile Include="DagMerge.fs" />
    <!-- Phase 267: converge a guest's forked stream into the host stream through
         the merge, the host's ops taking precedence (§4o). -->
    <Compile Include="GuestConvergence.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.UI\Fuaran.UI.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.Ops\Fuaran.UI.Ops.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.OpStream.Abstractions\Fuaran.UI.OpStream.Abstractions.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.OpStream.Replay\Fuaran.UI.OpStream.Replay.fsproj" />
    <ProjectReference Include="..\Fuaran.UI.OpStream.Dag.Abstractions\Fuaran.UI.OpStream.Dag.Abstractions.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <!-- Phase 2293: DagReconcile reads Core's conflict report (Dag.conflictsIn). -->
    <PackageReference Include="Fuaran.Core.OpStream.Dag" />
  </ItemGroup>
</Project>
