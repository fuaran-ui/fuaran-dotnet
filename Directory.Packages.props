<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the SQLitePCLRaw pins below flow to every project that references
         the SQLite sinks transitively (via Microsoft.Data.Sqlite) without a
         direct PackageReference in each .fsproj. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FSharp.Core" Version="10.1.300" />
    <!-- FCS pinned to the matching F# 10.1 generation; consumed by
         Fuaran.UI.Validator to parse F# untyped AST. -->
    <PackageVersion Include="FSharp.Compiler.Service" Version="43.12.204" />
    <PackageVersion Include="Expecto" Version="10.2.3" />
    <!-- Property-based generators for the Phase 101 wire-format fuzzer.
         Consumed ONLY by Fuaran.UI.JsonDecode.Tests (generative idempotence
         over Node/TreeOp trees). Test-only; not referenced by any shipping
         package. -->
    <PackageVersion Include="FsCheck" Version="3.1.0" />
    <!-- Roslyn — consumed by Fuaran.UI.Analyzers (Phase 314), the compile-time
         gate for the C# authoring veneer. Pinned to 4.11 (below the net10 SDK's
         own Roslyn) so the analyzer loads across the IDE/CLI matrix; the
         Fuaran.UI.Analyzers.Tests console runner also uses it to drive the
         analyzer over source snippets. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <!-- VB Roslyn — Phase 315 adds the VB XML-literal diagnostic leg to
         Fuaran.UI.Analyzers (VB XML literals are syntax, not IOperation). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.11.0" />
    <!-- Draft 2020-12 JSON Schema validator — consumed ONLY by
         Fuaran.UI.JsonDecode.Tests to assert the generated
         wire-format-fixtures/schema.json (Phase 96) accepts/rejects the corpus
         consistently with JsonDecode, using a real off-the-shelf validator
         (proves the schema is a genuine drop-in for external tooling). Test-only;
         not referenced by any shipping package. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.2.1" />
    <PackageVersion Include="Fake.Core.Target" Version="6.1.4" />
    <PackageVersion Include="Fake.IO.FileSystem" Version="6.1.4" />
    <!-- Renderer stack. -->
    <PackageVersion Include="Fable.Core" Version="5.0" />
    <PackageVersion Include="Fable.Elmish" Version="5.0.2" />
    <PackageVersion Include="Fable.Elmish.React" Version="5.6" />
    <PackageVersion Include="Fable.SimpleJson" Version="3.24" />
    <!-- Fable's typed `fetch` binding — consumed ONLY by
         samples/sdk-integration/client, the browser half of the server-proxied
         BYOK sample (the browser speaks the wire contract directly; the .NET
         Fuaran.UI.Client sits on the server side of the proxy). No shipping
         Fuaran.UI.* package takes this dependency. -->
    <PackageVersion Include="Fable.Fetch" Version="2.7.0" />
    <PackageVersion Include="Feliz" Version="3.3.3" />
    <!-- Server-side rendering (Phase 140). Feliz.ViewEngine emits HTML strings
         on plain .NET (no React / Fable) with the same Feliz-shaped API as the
         client renderer, so class/attribute emission stays near-identical;
         Markdig is the real server-side markdown processor (replacing the
         degraded <pre> fallback). Consumed only by Fuaran.UI.Renderer.Server. -->
    <PackageVersion Include="Feliz.ViewEngine" Version="1.0.3" />
    <PackageVersion Include="Markdig" Version="0.37.0" />
    <!-- Sqlite — consumed by Fuaran.UI.OpStream.Sqlite for the durable
         op-stream sink. Microsoft's official ADO.NET provider so the
         server-side sink runs on stock .NET without an extra native
         dependency. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.10" />
    <!-- Transitive pin (via Microsoft.Data.Sqlite -> SQLitePCLRaw.bundle_e_sqlite3).
         The 2.1.x native SQLite engine these packages vendor has a known
         high-severity vulnerability (GHSA-2m69-gcr7-jv3q, NU1903 numeric-truncation;
         affected range <= 2.1.11). Only the native-binary package
         SQLitePCLRaw.lib.e_sqlite3 is flagged; the SQLitePCLRaw.core / .provider /
         .bundle managed metapackages are not. The fix is the realigned 3.50.x line
         (versioned to match SQLite's own version). We pin ONLY the native lib —
         it carries no managed API surface, so the patched 3.50.3 engine drops in
         under the 2.1.10 managed provider Microsoft.Data.Sqlite 9.0.10 selects.
         CentralPackageTransitivePinningEnabled flows this to every project that
         references the SQLite op-stream sinks transitively. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <!-- Giraffe — consumed ONLY by Fuaran.UI.Giraffe (Phase 162), the thin
         SSR host-integration adapter (document shell + page HttpHandlers +
         render-cache seam). The language tier and Renderer.Server stay
         Giraffe-free; Giraffe is isolated to the new adapter package. -->
    <PackageVersion Include="Giraffe" Version="8.2.0" />
    <!-- BenchmarkDotNet — consumed ONLY by benchmarks/Fuaran.UI.Ops.Benchmarks
         (Phase 200, the apply / re-derivation perf harness). Package-excluded
         (IsPackable=false), so no shipped Fuaran.UI.* surface gains the
         dependency (FGP 2). -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
    <!-- Fuaran.Core substrate. Tree + Ops are consumed at RUNTIME by Fuaran.UI.Ops
         (Phase 379): the structural-five apply legs delegate to Fuaran.Core.Ops over
         the UI NodeWitness. Tree/Ops/OpStream/Conformance are additionally consumed
         test-only by Fuaran.UI.Tests (CoreAdoptionTests.fs) to certify the witness +
         op-stream against the shared conformance kit. FSharp.Core-only (FGP 2). -->
    <PackageVersion Include="Fuaran.Core.Tree" Version="0.1.11" />
    <PackageVersion Include="Fuaran.Core.Ops" Version="0.1.11" />
    <PackageVersion Include="Fuaran.Core.OpStream" Version="0.1.11" />
    <PackageVersion Include="Fuaran.Core.Conformance" Version="0.1.11" />
    <!-- Fuaran.Core Compute strand — consumed by SHIPPING Fuaran.UI.* (Phase 282/Wave 42, the
         core-ui-spine-unification beachhead): the typed surface (Fuaran.UI), the wire codec seam
         (Fuaran.UI.OpStream.Abstractions encode + Fuaran.UI.Ops decode), and the evaluator
         (Fuaran.UI.Ops, delegating to Fuaran.Core.DataFrame). Fable-distributed (source-packed) so
         the Fable client compiles them; the wire serialises in the shared Canon `$type` discipline. -->
    <PackageVersion Include="Fuaran.Core.Column" Version="0.1.11" />
    <PackageVersion Include="Fuaran.Core.DataFrame" Version="0.1.11" />
    <!-- Fuaran.Core.Wire — the canonical JVal JSON AST. Surfaced directly in the
         Fuaran.UI type contract (Custom props / action payloads / I18n args) and in
         TreeOp.UpdateProp's PropValue.Wire case. Already transitive via Column's
         codec; referenced explicitly because it is now part of the public surface. -->
    <PackageVersion Include="Fuaran.Core.Wire" Version="0.1.11" />
    <!-- Fuaran.Core.Function — the invocable `Capability` + registry surface, consumed by
         Fuaran.UI.AiTools (Phase 283, the capability discovery + dispatch glue). Fable-distributed. -->
    <PackageVersion Include="Fuaran.Core.Function" Version="0.1.11" />
    <!-- Fuaran.Core.Observer — the generic runtime-verification seam (Phase 322). Consumed by
         Fuaran.UI.LayoutObserver, which becomes a domain instance of it. Dependency-free
         (FSharp.Core only). Fable-distributed (source-packed) so the Fable client compiles it. -->
    <PackageVersion Include="Fuaran.Core.Observer" Version="0.1.11" />
  </ItemGroup>
</Project>
