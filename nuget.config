<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the Fuaran language tier. The `Fuaran.Core.*` substrate
  is consumed by PackageReference, resolved from nuget.org (the released
  channel) everywhere, with a local folder feed for inner-loop iteration —
  a fresh dev pack in `../../../local-nuget-feed` shadows a released package
  at the same version.

  The relative `../../../local-nuget-feed` path matches this repo's position
  inside the maintainers' checkout layout; CI mints an empty dir at that
  depth before restore (NuGet hard-errors NU1301 on a missing folder source
  rather than treating it as empty). Forward slashes for Linux CI portability.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="../../../local-nuget-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Fuaran.*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="Fuaran.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
