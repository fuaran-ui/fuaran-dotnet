<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the Fuaran language tier. The `Fuaran.Core.*` substrate
  is consumed by PackageReference, resolved from the workspace-shared local
  feed during inner-loop iteration (a fresh dev pack shadows a released
  package at the same version) and from the fuaran-ui GitHub Packages feed
  everywhere else — CI and standalone checkouts included.

  The relative `../../../local-nuget-feed` path matches this repo's position
  inside the maintainers' workspace checkout; CI mints an empty dir at that
  depth before restore (NuGet hard-errors NU1301 on a missing folder source
  rather than treating it as empty). Forward slashes for Linux CI portability.

  GitHub Packages NuGet requires auth even for public packages, so the
  credentials block is mandatory: set GITHUB_PACKAGES_USER (any value) and
  GITHUB_PACKAGES_TOKEN (a PAT with read:packages) locally; CI passes the
  Actions GITHUB_TOKEN.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="../../../local-nuget-feed" />
    <add key="github-fuaran" value="https://nuget.pkg.github.com/fuaran-ui/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="Fuaran.*" />
    </packageSource>
    <packageSource key="github-fuaran">
      <package pattern="Fuaran.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <github-fuaran>
      <add key="Username" value="%GITHUB_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github-fuaran>
  </packageSourceCredentials>
</configuration>
